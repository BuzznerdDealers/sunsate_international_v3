{
  "version": 2,
  "id": "hours-grid",
  "name": "Department hours",
  "css": "[data-bz-section=\"hours-grid\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"hours-grid\"] .bz-block + .bz-block { padding-block-start: 12px }\n[data-bz-section=\"hours-grid\"] .bz-row + .bz-row { margin-top: 44px }\n[data-bz-section=\"hours-grid\"] h3 { font-size: 19px; margin: 0 }\n[data-bz-section=\"hours-grid\"] [data-bz-node^=\"hg-card-rows\"] .bz-text p { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin: 0; padding: 10px 0; border-top: 1px solid var(--line); font-size: 14px }\n[data-bz-section=\"hours-grid\"] .bz-btns { margin-block: 0 0 4px }\n[data-bz-section=\"hours-grid\"] [data-bz-node=\"hg-note\"] p { font-size: 13px; color: var(--muted); margin-top: 28px }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "DEPARTMENT HOURS"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "When each department is open."
    },
    {
      "key": "note",
      "type": "textarea",
      "label": "Note under the tables",
      "default": ""
    },
    {
      "key": "span",
      "type": "number",
      "label": "Card width in grid columns",
      "default": 4
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "departments",
      "type": "list",
      "label": "Departments",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Department"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone (as displayed)"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link (tel:)"
        },
        {
          "key": "rows",
          "type": "textarea",
          "label": "Hours — one line per day"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "hg",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "card",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "hg-head",
          "type": "row",
          "props": {
            "gap": 5
          },
          "children": [
            {
              "id": "hg-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "hg-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "hg-grid",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "stretch"
          },
          "children": [
            {
              "id": "hg-card",
              "type": "column",
              "props": {
                "span": "{{span}}",
                "repeat": "departments"
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "line",
                  "paddingTop": 26,
                  "paddingRight": 26,
                  "paddingBottom": 26,
                  "paddingLeft": 26
                }
              },
              "children": [
                {
                  "id": "hg-card-h",
                  "type": "heading",
                  "props": {
                    "text": "{{title}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "hg-card-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{phone}}",
                        "url": "{{phoneUrl}}",
                        "style": "link",
                        "intent": "call-department"
                      }
                    ]
                  }
                },
                {
                  "id": "hg-card-rows",
                  "type": "text",
                  "props": {
                    "text": "{{rows}}",
                    "width": "full"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "hg-note-row",
          "type": "row",
          "props": {
            "gap": 5
          },
          "children": [
            {
              "id": "hg-note-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "hg-note",
                  "type": "text",
                  "props": {
                    "text": "{{note}}",
                    "width": "prose"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
