{
  "version": 2,
  "id": "hours-grid",
  "name": "Department hours",
  "css": "[data-bz-section=\"hours-grid\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"hours-grid\"] .bz-block + .bz-block { padding-block-start: 0 }\n[data-bz-section=\"hours-grid\"] h2 { margin: 0 0 40px }\n[data-bz-section=\"hours-grid\"] [data-bz-node=\"hg-hours\"] .bz-hours { background: var(--card); border: 1px solid var(--line); padding: 26px }\n[data-bz-section=\"hours-grid\"] [data-bz-node=\"hg-note\"] p { font-size: 13px; color: var(--muted); margin-top: 28px }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "DEPARTMENT HOURS"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "When each department is open."
    },
    {
      "key": "locationSlug",
      "type": "text",
      "label": "Location slug (must match Locations in the dashboard)",
      "default": ""
    },
    {
      "key": "note",
      "type": "textarea",
      "label": "Note under the tables",
      "default": ""
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "card",
      "options": [
        { "value": "card", "label": "White" },
        { "value": "paper", "label": "Paper" }
      ]
    }
  ],
  "nodes": [
    {
      "id": "hg",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "hg-head",
          "type": "row",
          "props": { "gap": 5 },
          "children": [
            {
              "id": "hg-head-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                {
                  "id": "hg-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "hg-hours-row",
          "type": "row",
          "props": { "gap": 5 },
          "children": [
            {
              "id": "hg-hours-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                {
                  "id": "hg-hours",
                  "type": "widget",
                  "props": {
                    "widget": "hours",
                    "config": { "locationSlug": "{{locationSlug}}" }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "hg-note-row",
          "type": "row",
          "props": { "gap": 5 },
          "children": [
            {
              "id": "hg-note-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                {
                  "id": "hg-note",
                  "type": "text",
                  "props": { "text": "{{note}}", "width": "full" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
