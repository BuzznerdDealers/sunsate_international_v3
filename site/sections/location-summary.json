{
  "version": 2,
  "id": "location-summary",
  "name": "Location summary",
  "css": "[data-bz-section=\"location-summary\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"location-summary\"] h2 { font-size: 30px; line-height: 1.6; margin: 0 0 18px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-phones\"] .bz-phones { margin: 0 0 22px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] { border: 1px solid var(--line); background: var(--card); padding: 26px 24px; margin-top: 0 }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] .bz-eyebrow { font-size: 10px; letter-spacing: .14em; margin-bottom: 12px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] h3 { font-size: 20px; line-height: 1.6; margin: 0 0 10px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] .bz-block + .bz-block { padding-block-start: 0 }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice-b\"] p { font-size: 15px; line-height: 1.7; margin: 0 0 12px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice-cta\"] .bz-btns { margin-block: 0 }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice-cta\"] .bz-btn--link { font-size: 16px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-map\"] .bz-map { width: 100%; min-height: 520px; aspect-ratio: auto; margin: 0; border-radius: 0 }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-map\"] .bz-loclist { display: none }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "STORE MAP"
    },
    {
      "key": "name",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "locationSlug",
      "type": "text",
      "label": "Location slug (must match Locations in the dashboard)",
      "default": ""
    },
    {
      "key": "noticeEyebrow",
      "type": "text",
      "label": "Notice eyebrow",
      "default": ""
    },
    {
      "key": "noticeTitle",
      "type": "text",
      "label": "Notice title",
      "default": ""
    },
    {
      "key": "noticeBody",
      "type": "textarea",
      "label": "Notice body",
      "default": ""
    },
    {
      "key": "noticeLinkLabel",
      "type": "text",
      "label": "Notice link label",
      "default": ""
    },
    {
      "key": "noticeLinkUrl",
      "type": "url",
      "label": "Notice link",
      "default": ""
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "paper",
      "options": [
        { "value": "card", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "none", "label": "None" }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ls",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "ls-row",
          "type": "row",
          "props": { "gap": 7, "align": "stretch", "stackOn": "tablet" },
          "children": [
            {
              "id": "ls-copy",
              "type": "column",
              "props": { "span": 6 },
              "children": [
                {
                  "id": "ls-h",
                  "type": "heading",
                  "props": {
                    "text": "{{name}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "ls-phones",
                  "type": "widget",
                  "props": {
                    "widget": "phone-numbers",
                    "config": { "locationSlug": "{{locationSlug}}" }
                  }
                },
                {
                  "id": "ls-notice",
                  "type": "row",
                  "props": { "gap": 3 },
                  "children": [
                    {
                      "id": "ls-notice-col",
                      "type": "column",
                      "props": { "span": 12 },
                      "children": [
                        {
                          "id": "ls-notice-h",
                          "type": "heading",
                          "props": {
                            "text": "{{noticeTitle}}",
                            "eyebrow": "{{noticeEyebrow}}",
                            "headingLevel": 3
                          }
                        },
                        {
                          "id": "ls-notice-b",
                          "type": "text",
                          "props": { "text": "{{noticeBody}}", "width": "full" }
                        },
                        {
                          "id": "ls-notice-cta",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{noticeLinkLabel}}",
                                "url": "{{noticeLinkUrl}}",
                                "style": "link",
                                "intent": "learn-more"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "ls-map",
              "type": "column",
              "props": { "span": 6 },
              "children": [
                {
                  "id": "ls-map-w",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "showMap": true,
                      "locationSlug": "{{locationSlug}}"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
