{
  "version": 2,
  "id": "location-summary",
  "name": "Location summary",
  "css": "[data-bz-section=\"location-summary\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"location-summary\"] h2 { font-size: 30px; line-height: 1.6; margin: 0 0 18px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-phones\"] .bz-phones { margin: 0 0 22px }\n[data-bz-section=\"location-summary\"] [data-bz-node^=\"ls-addr\"] p { font-size: 16px; line-height: 1.75; margin: 0 0 4px }\n[data-bz-section=\"location-summary\"] [data-bz-node^=\"ls-phone\"] { margin: 16px 0 8px }\n[data-bz-section=\"location-summary\"] [data-bz-node^=\"ls-phone\"] p { font-size: 15px; font-weight: 700; margin: 0; border-top: 1px solid var(--line); padding-top: 12px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] { background: var(--ink); color: #fff; padding: 28px; margin-top: 8px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] .bz-eyebrow { font-size: 10px; letter-spacing: .14em; color: var(--accent); margin-bottom: 12px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] h3 { font-size: 20px; line-height: 1.4; color: #fff; margin: 0 0 10px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] p,\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] a { color: #fff }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] .bz-block + .bz-block { padding-block-start: 0 }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice-b\"] p { font-size: 15px; line-height: 1.7; margin: 0 0 12px }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice-cta\"] .bz-btns { margin-block: 0 }\n/* The branch’s own photograph, from its record on Admin → Locations. No fixed\n   height — the photo keeps its own aspect ratio — and a rooftop with no photo\n   yet draws an empty box rather than a stand-in, so the gap reads as \"upload\n   one\" instead of being papered over with a street map. */\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-map\"] .bz-locphoto img { display: block; width: 100%; height: auto }\n[data-bz-section=\"location-summary\"] [data-bz-node=\"ls-map\"] .bz-locphoto__empty { aspect-ratio: 4 / 3; border-radius: 0 }\n@media (max-width: 640px) {\n  [data-bz-section=\"location-summary\"] [data-bz-node=\"ls-notice\"] .bz-eyebrow { font-size: 12px; }\n}",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "STORE MAP"
    },
    {
      "key": "name",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "locationSlug",
      "type": "text",
      "label": "Location slug (must match Locations in the dashboard)",
      "default": ""
    },
    {
      "key": "rooftop",
      "type": "list",
      "label": "This branch (from Locations)",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "subtitle",
          "type": "text",
          "label": "Trading as"
        },
        {
          "key": "streetAddress",
          "type": "text",
          "label": "Street"
        },
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        },
        {
          "key": "postalCode",
          "type": "text",
          "label": "ZIP"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link"
        },
        {
          "key": "email",
          "type": "text",
          "label": "Email"
        },
        {
          "key": "mapUrl",
          "type": "url",
          "label": "Directions"
        }
      ],
      "default": []
    },
    {
      "key": "noticeEyebrow",
      "type": "text",
      "label": "Notice eyebrow",
      "default": ""
    },
    {
      "key": "noticeTitle",
      "type": "text",
      "label": "Notice title",
      "default": ""
    },
    {
      "key": "noticeBody",
      "type": "textarea",
      "label": "Notice body",
      "default": ""
    },
    {
      "key": "noticeLinkLabel",
      "type": "text",
      "label": "Notice link label",
      "default": ""
    },
    {
      "key": "noticeLinkUrl",
      "type": "url",
      "label": "Notice link",
      "default": ""
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "paper",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ls",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "ls-row",
          "type": "row",
          "props": {
            "gap": 7,
            "align": "stretch",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "ls-copy",
              "type": "column",
              "props": {
                "span": 7
              },
              "children": [
                {
                  "id": "ls-id",
                  "type": "row",
                  "props": {
                    "gap": 3,
                    "repeat": "rooftop"
                  },
                  "children": [
                    {
                      "id": "ls-id-col",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "children": [
                        {
                          "id": "ls-h",
                          "type": "heading",
                          "props": {
                            "text": "{{name}}",
                            "eyebrow": "{{eyebrow}}",
                            "headingLevel": 2
                          }
                        },
                        {
                          "id": "ls-sub",
                          "type": "text",
                          "props": {
                            "text": "{{subtitle}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "ls-addr",
                          "type": "text",
                          "props": {
                            "text": "{{streetAddress}}\n\n{{city}}, {{region}} {{postalCode}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "ls-phone",
                          "type": "text",
                          "props": {
                            "text": "<strong>MAIN</strong> <a href=\"{{phoneUrl}}\">{{phone}}</a>",
                            "width": "full"
                          }
                        },
                        {
                          "id": "ls-dir",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "Get directions",
                                "url": "{{mapUrl}}",
                                "style": "link",
                                "intent": "find-location"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "ls-phones",
                  "type": "widget",
                  "props": {
                    "widget": "phone-numbers",
                    "config": {
                      "locationSlug": "{{locationSlug}}"
                    }
                  }
                },
                {
                  "id": "ls-notice",
                  "type": "row",
                  "props": {
                    "gap": 3
                  },
                  "children": [
                    {
                      "id": "ls-notice-col",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "children": [
                        {
                          "id": "ls-notice-h",
                          "type": "heading",
                          "props": {
                            "text": "{{noticeTitle}}",
                            "eyebrow": "{{noticeEyebrow}}",
                            "headingLevel": 3
                          }
                        },
                        {
                          "id": "ls-notice-b",
                          "type": "text",
                          "props": {
                            "text": "{{noticeBody}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "ls-notice-cta",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{noticeLinkLabel}}",
                                "url": "{{noticeLinkUrl}}",
                                "style": "link",
                                "intent": "learn-more"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "ls-map",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "ls-map-w",
                  "type": "widget",
                  "props": {
                    "widget": "location-photo",
                    "config": {
                      "locationSlug": "{{locationSlug}}"
                    },
                    "snapshot": {
                      "photo": {
                        "src": "",
                        "alt": ""
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
