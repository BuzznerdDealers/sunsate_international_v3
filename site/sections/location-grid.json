{
  "version": 2,
  "id": "location-grid",
  "name": "Location card grid",
  "css": "[data-bz-section=\"location-grid\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"location-grid\"] .bz-block + .bz-block { padding-block-start: 0 }\n[data-bz-section=\"location-grid\"] .bz-row + .bz-row { margin-top: 0 }\n[data-bz-section=\"location-grid\"] h2 { margin: 0 0 18px }\n[data-bz-section=\"location-grid\"] [data-bz-node=\"lg-body\"] p { font-size: 16px; line-height: 1.7; color: var(--body-text); margin: 0 0 40px; max-width: 820px }\n[data-bz-section=\"location-grid\"] h3 { font-size: 21px; line-height: 1.6; margin: 0 0 6px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-h\"] .bz-eyebrow { font-size: 10px; line-height: 1.3; letter-spacing: .14em; color: var(--accent); margin-bottom: 12px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-addr\"] p { font-size: 14px; line-height: 1.6; color: var(--muted); margin: 0 0 18px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-hours\"] .bz-text { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-hours\"] p { font-size: 14px; line-height: 1.5; color: var(--body-text); border-top: 1px solid var(--line); padding-top: 8px; margin: 0 }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-perks\"] p { font-size: 13px; line-height: 1.55; color: var(--muted); margin: 0 0 18px }\n/* The handoff sets the phone 14px under the card's own text, not against the\n   card floor: in a row of four, three of them end well above it. */\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-cta\"] { margin-top: 14px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-links\"] { padding-block-start: 8px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-links\"] .bz-btn--link { font-size: 14px }\n[data-bz-section=\"location-grid\"] .bz-btns { margin-block: 0; gap: 8px; flex-direction: column; align-items: flex-start }\n[data-bz-section=\"location-grid\"] .bz-btn--link { font-size: 15px; line-height: 1.6 }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-map\"] .bz-map { width: 100%; aspect-ratio: auto; min-height: 440px; margin-bottom: 40px }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "body",
      "type": "textarea",
      "label": "Intro",
      "default": ""
    },
    {
      "key": "span",
      "type": "number",
      "label": "Card width in grid columns",
      "default": 4
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "card",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "ink",
          "label": "Dark chrome"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "locations",
      "type": "list",
      "label": "Locations",
      "fields": [
        {
          "key": "tag",
          "type": "text",
          "label": "Departments on site"
        },
        {
          "key": "city",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "address",
          "type": "text",
          "label": "Address"
        },
        {
          "key": "hours",
          "type": "text",
          "label": "Hours"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone (as displayed)"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link (tel:)"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Location page"
        },
        {
          "key": "perks",
          "type": "text",
          "label": "Perks line"
        },
        {
          "key": "phone2",
          "type": "text",
          "label": "Second phone label"
        },
        {
          "key": "phone2Url",
          "type": "url",
          "label": "Second phone link"
        },
        {
          "key": "phone3",
          "type": "text",
          "label": "Third phone label"
        },
        {
          "key": "phone3Url",
          "type": "url",
          "label": "Third phone link"
        },
        {
          "key": "directionsUrl",
          "type": "url",
          "label": "Directions link"
        },
        {
          "key": "linkLabel",
          "type": "text",
          "label": "Link label"
        },
        {
          "key": "directionsLabel",
          "type": "text",
          "label": "Directions label"
        }
      ]
    },
    {
      "key": "map",
      "type": "list",
      "label": "Map (add one empty row to show the locations map)",
      "fields": [
        {
          "key": "show",
          "type": "boolean",
          "label": "Show"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "lg",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "lg-head",
          "type": "row",
          "props": {
            "gap": 5
          },
          "children": [
            {
              "id": "lg-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "lg-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "lg-body",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "prose"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "lg-map",
          "type": "row",
          "props": {
            "gap": 5,
            "repeat": "map"
          },
          "children": [
            {
              "id": "lg-map-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "lg-map-w",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "showMap": true
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "lg-grid",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "stretch"
          },
          "children": [
            {
              "id": "lg-card",
              "type": "column",
              "props": {
                "span": "{{span}}",
                "repeat": "locations"
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "line",
                  "paddingTop": 26,
                  "paddingRight": 26,
                  "paddingBottom": 26,
                  "paddingLeft": 26
                }
              },
              "children": [
                {
                  "id": "lg-card-h",
                  "type": "heading",
                  "props": {
                    "text": "{{city}}",
                    "eyebrow": "{{tag}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "lg-card-addr",
                  "type": "text",
                  "props": {
                    "text": "{{address}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lg-card-hours",
                  "type": "text",
                  "props": {
                    "text": "{{hours}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lg-card-perks",
                  "type": "text",
                  "props": {
                    "text": "{{perks}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lg-card-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{phone}}",
                        "url": "{{phoneUrl}}",
                        "style": "link",
                        "intent": "call-location"
                      },
                      {
                        "label": "{{phone2}}",
                        "url": "{{phone2Url}}",
                        "style": "link",
                        "intent": "call-location"
                      },
                      {
                        "label": "{{phone3}}",
                        "url": "{{phone3Url}}",
                        "style": "link",
                        "intent": "call-location"
                      }
                    ]
                  }
                },
                {
                  "id": "lg-card-links",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{linkLabel}}",
                        "url": "{{url}}",
                        "style": "link",
                        "intent": "find-location"
                      },
                      {
                        "label": "{{directionsLabel}}",
                        "url": "{{directionsUrl}}",
                        "style": "link",
                        "intent": "find-location"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
