{
  "version": 2,
  "id": "location-grid",
  "name": "Location card grid",
  "css": "[data-bz-section=\"location-grid\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"location-grid\"] .bz-block + .bz-block { padding-block-start: 0 }\n[data-bz-section=\"location-grid\"] h2 { margin: 0 0 18px }\n[data-bz-section=\"location-grid\"] [data-bz-node=\"lg-body\"] p { font-size: 16px; line-height: 1.7; color: var(--body-text); margin: 0 0 40px; max-width: 820px }\n[data-bz-section=\"location-grid\"] [data-bz-node=\"lg-list\"] .bz-map { width: 100%; aspect-ratio: auto; min-height: 440px; margin-bottom: 40px }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "body",
      "type": "textarea",
      "label": "Intro",
      "default": ""
    },
    {
      "key": "showMap",
      "type": "boolean",
      "label": "Show the map above the cards",
      "default": false
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "card",
      "options": [
        { "value": "card", "label": "White" },
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Dark chrome" },
        { "value": "none", "label": "None" }
      ]
    }
  ],
  "nodes": [
    {
      "id": "lg",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "lg-head",
          "type": "row",
          "props": { "gap": 5 },
          "children": [
            {
              "id": "lg-head-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                {
                  "id": "lg-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "lg-body",
                  "type": "text",
                  "props": { "text": "{{body}}", "width": "prose" }
                }
              ]
            }
          ]
        },
        {
          "id": "lg-list-row",
          "type": "row",
          "props": { "gap": 5 },
          "children": [
            {
              "id": "lg-list-col",
              "type": "column",
              "props": { "span": 12 },
              "children": [
                {
                  "id": "lg-list",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "showMap": "{{showMap}}",
                      "pagePathPrefix": "/locations"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
