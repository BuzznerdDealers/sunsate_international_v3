{
  "version": 2,
  "id": "location-grid",
  "name": "Location card grid",
  "css": "[data-bz-section=\"location-grid\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"location-grid\"] .bz-block + .bz-block { padding-block-start: 10px }\n[data-bz-section=\"location-grid\"] .bz-row + .bz-row { margin-top: 44px }\n[data-bz-section=\"location-grid\"] h3 { font-size: 19px; margin: 0 0 8px }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-card-h\"] .bz-eyebrow { font-size: 10px; letter-spacing: .1em; color: var(--accent); margin-bottom: 12px }\n[data-bz-section=\"location-grid\"] .bz-col p { font-size: 14px; color: #3f3f3f; margin: 0 }\n[data-bz-section=\"location-grid\"] .bz-btns { margin-block: 14px 0; gap: 6px; flex-direction: column; align-items: flex-start }\n[data-bz-section=\"location-grid\"] [data-bz-node^=\"lg-map\"] .bz-map { width: 100%; aspect-ratio: auto; min-height: 440px; margin-bottom: 40px }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "FIND A LOCATION"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Find a location"
    },
    {
      "key": "body",
      "type": "textarea",
      "label": "Intro",
      "default": ""
    },
    {
      "key": "span",
      "type": "number",
      "label": "Card width in grid columns",
      "default": 4
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "card",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "ink",
          "label": "Dark chrome"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "locations",
      "type": "list",
      "label": "Locations",
      "fields": [
        {
          "key": "tag",
          "type": "text",
          "label": "Departments on site"
        },
        {
          "key": "city",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "address",
          "type": "text",
          "label": "Address"
        },
        {
          "key": "hours",
          "type": "text",
          "label": "Hours"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone (as displayed)"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link (tel:)"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Location page"
        }
      ]
    },
    {
      "key": "map",
      "type": "list",
      "label": "Map (add one empty row to show the locations map)",
      "fields": [
        {
          "key": "show",
          "type": "boolean",
          "label": "Show"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "lg",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "lg-head",
          "type": "row",
          "props": {
            "gap": 5
          },
          "children": [
            {
              "id": "lg-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "lg-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "lg-body",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "prose"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "lg-map",
          "type": "row",
          "props": {
            "gap": 5,
            "repeat": "map"
          },
          "children": [
            {
              "id": "lg-map-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "lg-map-w",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "showMap": true
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "lg-grid",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "stretch"
          },
          "children": [
            {
              "id": "lg-card",
              "type": "column",
              "props": {
                "span": "{{span}}",
                "repeat": "locations"
              },
              "styles": {
                "base": {
                  "background": "card",
                  "borderWidth": 1,
                  "borderStyle": "solid",
                  "borderColor": "line",
                  "paddingTop": 26,
                  "paddingRight": 26,
                  "paddingBottom": 26,
                  "paddingLeft": 26
                }
              },
              "children": [
                {
                  "id": "lg-card-h",
                  "type": "heading",
                  "props": {
                    "text": "{{city}}",
                    "eyebrow": "{{tag}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "lg-card-addr",
                  "type": "text",
                  "props": {
                    "text": "{{address}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lg-card-hours",
                  "type": "text",
                  "props": {
                    "text": "{{hours}}",
                    "width": "full"
                  }
                },
                {
                  "id": "lg-card-cta",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{phone}}",
                        "url": "{{phoneUrl}}",
                        "style": "link",
                        "intent": "call-location"
                      },
                      {
                        "label": "Hours & directions →",
                        "url": "{{url}}",
                        "style": "link",
                        "intent": "find-location"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}