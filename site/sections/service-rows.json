{
  "version": 2,
  "id": "service-rows",
  "name": "Numbered service rows",
  "css": "/* The handoff gives this band 120px of air and lays each row out as a\n   60px / 1fr / auto grid with a 28px gutter, not as twelve columns. */\n[data-bz-section=\"service-rows\"] > .bz-section { padding-block: 120px }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-row\"] { grid-template-columns: 60px 1fr auto; column-gap: 28px }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-row\"] > .bz-col { grid-column: auto }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-row\"] + [data-bz-node^=\"sr-row\"] { margin-top: 0 }\n[data-bz-section=\"service-rows\"] .bz-block { padding-block: 0 }\n[data-bz-section=\"service-rows\"] [data-bz-node=\"sr-head-col\"] .bz-block + .bz-block { padding-block-start: 20px }\n[data-bz-section=\"service-rows\"] h2 { font-size: 38px; margin: 0 }\n[data-bz-section=\"service-rows\"] [data-bz-node=\"sr-body\"] .bz-text { max-width: 680px }\n[data-bz-section=\"service-rows\"] [data-bz-node=\"sr-body\"] p { color: var(--body-text) }\n[data-bz-section=\"service-rows\"] [data-bz-node=\"sr-head\"] { margin-bottom: 52px }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-row\"] { border-top: 1px solid var(--line); padding-block: 32px }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-row\"]:last-child { border-bottom: 1px solid var(--line) }\n[data-bz-section=\"service-rows\"] h3 { font-size: 20px; font-weight: 700; line-height: 1.6; margin: 0 0 4px }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-desc\"] p { font-size: 15px; color: var(--body-text); line-height: 1.6 }\n[data-bz-section=\"service-rows\"] [data-bz-node^=\"sr-num\"] p { font: 800 20px/1.6 var(--font-heading); color: var(--muted) }\n[data-bz-section=\"service-rows\"] .bz-btns { margin-block: 0; justify-content: flex-end }\n[data-bz-section=\"service-rows\"] .bz-btn--link { line-height: 1.6; padding-block: 4px; white-space: nowrap }\n[data-bz-section=\"service-rows\"] .bz-btn--link { text-decoration: none }\n[data-bz-section=\"service-rows\"] .bz-btn--link:hover { text-decoration: underline }",
  "props": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Eyebrow",
      "default": "OUR INVENTORY"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": ""
    },
    {
      "key": "body",
      "type": "textarea",
      "label": "Intro",
      "default": ""
    },
    {
      "key": "background",
      "type": "select",
      "label": "Band background",
      "default": "paper",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "ink",
          "label": "Dark chrome"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "key": "anchor",
      "type": "text",
      "label": "Anchor id",
      "default": ""
    },
    {
      "key": "items",
      "type": "list",
      "label": "Rows",
      "fields": [
        {
          "key": "num",
          "type": "text",
          "label": "Number"
        },
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "body",
          "type": "textarea",
          "label": "Description"
        },
        {
          "key": "linkLabel",
          "type": "text",
          "label": "Link label"
        },
        {
          "key": "linkUrl",
          "type": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "sr",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "{{background}}",
        "paddingY": 10,
        "anchor": "{{anchor}}"
      },
      "children": [
        {
          "id": "sr-head",
          "type": "row",
          "props": {
            "gap": 5
          },
          "children": [
            {
              "id": "sr-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "sr-h",
                  "type": "heading",
                  "props": {
                    "text": "{{heading}}",
                    "eyebrow": "{{eyebrow}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "sr-body",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "prose"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sr-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "center",
            "repeat": "items",
            "stackOn": "mobile"
          },
          "children": [
            {
              "id": "sr-num",
              "type": "column",
              "props": {
                "span": 1,
                "align": "center"
              },
              "children": [
                {
                  "id": "sr-num-t",
                  "type": "text",
                  "props": {
                    "text": "{{num}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "sr-copy",
              "type": "column",
              "props": {
                "span": 8,
                "align": "center"
              },
              "children": [
                {
                  "id": "sr-title",
                  "type": "heading",
                  "props": {
                    "text": "{{title}}",
                    "headingLevel": 3
                  }
                },
                {
                  "id": "sr-desc",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "sr-link",
              "type": "column",
              "props": {
                "span": 3,
                "align": "center"
              },
              "children": [
                {
                  "id": "sr-link-b",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{linkLabel}}",
                        "url": "{{linkUrl}}",
                        "style": "link",
                        "intent": "browse-inventory"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
