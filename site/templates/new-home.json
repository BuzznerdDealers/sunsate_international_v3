{
  "version": 2,
  "id": "new-home",
  "name": "New Home template",
  "conditions": [
    {
      "type": "page",
      "ref": "new-home"
    }
  ],
  "nodes": [
    {
      "id": "site-header",
      "type": "section",
      "props": {
        "width": "full",
        "background": "none",
        "paddingY": 0
      },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "header-logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "text": "Sun State International Trucks",
                    "image": {
                      "src": "https://vendure.buzznerdrv.com/assets/source/57/logo-white__02.png",
                      "alt": "Sun State International Trucks",
                      "width": 3638,
                      "height": 887
                    },
                    "height": 75
                  }
                }
              ]
            },
            {
              "id": "header-bar",
              "type": "column",
              "props": {
                "span": 8,
                "align": "center"
              },
              "children": [
                {
                  "id": "header-bar-row",
                  "type": "row",
                  "props": {
                    "gap": 3,
                    "align": "center",
                    "stackOn": "never"
                  },
                  "children": [
                    {
                      "id": "header-nav",
                      "type": "column",
                      "props": {
                        "span": 9,
                        "align": "center"
                      },
                      "children": [
                        {
                          "id": "main-nav",
                          "type": "menu",
                          "props": {
                            "menuId": "main-mega",
                            "layout": "mega",
                            "align": "end",
                            "collapseOnMobile": true,
                            "depth": 3
                          },
                          "styles": {
                            "base": {
                              "textTransform": "uppercase",
                              "fontWeight": "500",
                              "fontSize": 13
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "header-cta",
                      "type": "column",
                      "props": {
                        "span": 3,
                        "align": "center"
                      },
                      "children": [
                        {
                          "id": "header-phone",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "ctaId": "header-phone"
                              }
                            ],
                            "align": "left"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      },
      "children": []
    },
    {
      "id": "site-footer",
      "type": "sharedSection",
      "props": {
        "sectionId": "site-footer",
        "values": {
          "blurb": "International trucks, IC Bus, Hyundai Translead and Globe Trailers. Serving Tampa, Davenport, Sarasota and Brooksville, Florida for 25 years.",
          "emailLabel": "e-contact@sunstateintl.com",
          "emailUrl": "mailto:e-contact@sunstateintl.com",
          "logo": {
            "src": "https://vendure.buzznerdrv.com/assets/source/57/logo-white__02.png",
            "alt": "Sun State International Trucks",
            "width": 8962,
            "height": 1774
          },
          "social": [
            {
              "label": "Twitter",
              "url": "https://x.com/SunStateIntl",
              "icon": {
                "src": "https://vendure.buzznerdrv.com/assets/source/f3/international_icon_twitter_white.svg",
                "alt": "Twitter",
                "width": 32,
                "height": 32
              }
            },
            {
              "label": "Facebook",
              "url": "https://www.facebook.com/sunstateintl",
              "icon": {
                "src": "https://vendure.buzznerdrv.com/assets/source/5e/international_icon_facebook_white.svg",
                "alt": "Facebook",
                "width": 32,
                "height": 32
              }
            },
            {
              "label": "Instagram",
              "url": "https://www.instagram.com/sunstateintl/",
              "icon": {
                "src": "https://vendure.buzznerdrv.com/assets/source/06/international_icon_instagram_white.svg",
                "alt": "Instagram",
                "width": 32,
                "height": 32
              }
            },
            {
              "label": "LinkedIn",
              "url": "https://www.linkedin.com/company/sun-state-international-trucks/",
              "icon": {
                "src": "https://vendure.buzznerdrv.com/assets/source/d7/international_icon_linkedin_white.svg",
                "alt": "LinkedIn",
                "width": 32,
                "height": 32
              }
            },
            {
              "label": "YouTube",
              "url": "https://www.youtube.com/channel/UCZw35HTHQi737CZnkV22nww",
              "icon": {
                "src": "https://vendure.buzznerdrv.com/assets/source/38/international_icon_youtube_white.svg",
                "alt": "YouTube",
                "width": 32,
                "height": 32
              }
            }
          ],
          "linkColumns": [
            {
              "heading": "Brands",
              "menuId": "footer-brands"
            },
            {
              "heading": "Shop",
              "menuId": "footer-shop"
            },
            {
              "heading": "Company",
              "menuId": "footer-company"
            }
          ]
        }
      },
      "children": []
    },
    {
      "id": "footer-legal",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 0
      },
      "children": [
        {
          "id": "footer-legal-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center"
          },
          "children": [
            {
              "id": "footer-copyright",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-copy",
                  "type": "text",
                  "props": {
                    "text": "© 2026 Sun State International Trucks, LLC. All rights reserved.",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "footer-legal-links",
              "type": "column",
              "props": {
                "span": 6,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-legal-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "legal",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "footer-built-row",
          "type": "row",
          "props": {
            "gap": 3
          },
          "children": [
            {
              "id": "footer-built",
              "type": "column",
              "props": {
                "span": 12,
                "align": "center"
              },
              "children": [
                {
                  "id": "footer-built-t",
                  "type": "text",
                  "props": {
                    "text": "Built by",
                    "align": "center",
                    "width": "full"
                  }
                },
                {
                  "id": "footer-built-logo",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/img/buzznerd-logo-cropped.png",
                      "alt": "BuzzNerd",
                      "width": 260,
                      "height": 40
                    },
                    "width": "full"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
