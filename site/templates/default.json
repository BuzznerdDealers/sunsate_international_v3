                }
              ]
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": {
                "span": 7,
                "align": "center"
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "mega",
                    "align": "end",
                    "collapseOnMobile": true,
                    "depth": 3
