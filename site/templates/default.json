      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "minHeight": 108
            },
            "mobile": {
              "minHeight": 84
            }
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 3,
                "align": "center"
              },
              "children": [
                {
                  "id": "header-logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "text": "Sun State International Trucks",
                    "image": {
                      "src": "https://vendure.buzznerdrv.com/assets/source/57/logo-white__02.png",
                      "alt": "Sun State International Trucks",
                      "width": 8962,
                      "height": 1774
                    },
                    "height": 75
