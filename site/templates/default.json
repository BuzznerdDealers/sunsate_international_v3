              "children": [
                {
                  "id": "utility-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  },
                  "styles": {
                    "base": {
                      "textTransform": "uppercase"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "site-header",
      "type": "section",
      "props": {
        "width": "full",
        "background": "ink",
        "paddingY": 0
