                  "props": {
                    "tone": "light",
                    "links": [
                      {
                        "label": "Twitter",
                        "url": "https://x.com/SunStateIntl",
                        "icon": {
                          "src": "/icons/twitter.svg",
                          "alt": "Twitter"
                        }
                      },
                      {
                        "label": "Facebook",
                        "url": "https://www.facebook.com/sunstateintl",
                        "icon": {
                          "src": "/icons/facebook.svg",
                          "alt": "Facebook"
                        }
                      },
                      {
                        "label": "Instagram",
                        "url": "https://www.instagram.com/sunstateintl/",
                        "icon": {
                          "src": "/icons/instagram.svg",
                          "alt": "Instagram"
                        }
                      },
                      {
                        "label": "LinkedIn",
                        "url": "https://www.linkedin.com/company/sun-state-international-trucks/",
                        "icon": {
                          "src": "/icons/linkedin.svg",
                          "alt": "Linkedin"
                        }
                      },
                      {
                        "label": "YouTube",
                        "url": "https://www.youtube.com/channel/UCZw35HTHQi737CZnkV22nww",
                        "icon": {
                          "src": "/icons/youtube.svg",
                          "alt": "Youtube"
                        }
                      }
