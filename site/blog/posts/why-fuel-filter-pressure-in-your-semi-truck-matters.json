                      "alt": "Technician reviewing parts records for fleet maintenance at Sun State International"
                    }
                  }
                },
                {
                  "id": "h-keep-running",
                  "type": "heading",
                  "props": {
                    "text": "Keep Your Trucks Running Strong With Sun State International",
                    "headingLevel": 2,
                    "align": "left",
