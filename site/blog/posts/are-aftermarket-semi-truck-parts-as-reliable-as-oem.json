                },
                {
                  "id": "p-how-to-choose-1",
                  "type": "text",
                  "props": {
                    "text": "The right choice depends on your goals:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-how-to-choose-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Looking for savings? Choose trusted aftermarket options to cut costs without sacrificing performance."
                      },
                      {
                        "text": "Under warranty or brand-new truck? Stick with OEM to stay compliant."
                      },
                      {
                        "text": "Running older models? Aftermarket parts often make more sense financially, especially for non-critical systems."
                      }
                    ]
                  }
                },
                {
                  "id": "p-how-to-choose-3",
                  "type": "text",
                  "props": {
                    "text": "Our experienced service advisors can help you evaluate which parts align with your truck's condition, workload, and maintenance schedule. Shop our Online Parts Store to browse our full inventory of OEM and aftermarket truck parts available across Tampa, Sarasota, Davenport, and Brooksville.",
                    "align": "left",
                    "width": "full"
                  }
                },
