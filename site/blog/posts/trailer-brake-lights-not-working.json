                      },
                      {
                        "text": "Corrosion near connectors"
                      },
                      {
                        "text": "Blown fuses"
                      },
                      {
                        "text": "Loose wiring harnesses"
                      },
                      {
                        "text": "Moisture inside light assemblies"
                      }
                    ]
                  }
                },
                {
                  "id": "p-warning-signs-4",
                  "type": "text",
                  "props": {
                    "text": "If you notice any of these symptoms, it's a good idea to <a href=\"/service-appointment\">schedule an inspection</a> before the problem worsens.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
