                  "type": "text",
                  "props": {
                    "text": "Brake maintenance is more than a box to check; it's a commitment to safety and reliability. By partnering with Sun State International, you get:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-partner-2",
