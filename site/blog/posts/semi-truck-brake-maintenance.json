                    }
                  ]
                },
                {
                  "id": "h-professional-service",
                  "type": "heading",
                  "props": {
                    "text": "Professional Brake Inspections and Service",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "professional-service"
                  }
                },
                {
                  "id": "p-professional-service-1",
                  "type": "text",
                  "props": {
                    "text": "Brake systems are complex, and when they fail, the results can be catastrophic. That's why you should always trust professionals who know your truck inside and out. Our technicians at Sun State International are factory-trained and certified to service all International Truck models, as well as other major brands. Whether you need a quick inspection, a full brake overhaul, or advanced diagnostics, we provide straightforward, dependable service backed by years of expertise. We handle:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-professional-service-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Brake pad, rotor, and drum replacements"
                      },
                      {
                        "text": "Air brake system inspections"
                      },
                      {
                        "text": "Hydraulic system maintenance"
                      },
                      {
                        "text": "Leak detection and line replacement"
                      },
                      {
                        "text": "Anti-lock braking system (ABS) repairs"
                      }
                    ]
                  }
                },
                {
                  "id": "p-professional-service-3",
                  "type": "text",
                  "props": {
                    "text": "No upselling. No hidden costs. Just professional, honest care you can count on. Ready to book your next service? Schedule through our Service Department today and keep your fleet rolling safely.",
                    "align": "left",
                    "width": "full"
                  }
                },
