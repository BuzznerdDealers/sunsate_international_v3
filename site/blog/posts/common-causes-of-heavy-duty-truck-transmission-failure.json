                },
                {
                  "id": "p-poor-maintenance-1",
                  "type": "text",
                  "props": {
                    "text": "One of the most common causes of heavy-duty truck transmission failure is something surprisingly simple: neglected maintenance.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-poor-maintenance-2",
                  "type": "text",
                  "props": {
                    "text": "Transmission fluid plays several critical roles:",
                    "align": "left",
                    "width": "full"
