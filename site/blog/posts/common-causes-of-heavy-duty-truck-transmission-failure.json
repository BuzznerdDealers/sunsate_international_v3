                },
                {
                  "id": "list-excessive-heat-5",
                  "type": "prose-list",
                  "props": {
                    "ordered": false,
                    "items": [
                      {
                        "text": "Burning smells"
                      },
                      {
                        "text": "Delayed gear shifts"
                      },
                      {
                        "text": "Slipping gears"
                      },
                      {
                        "text": "Warning lights"
                      }
                    ]
                  }
                },
                {
                  "id": "p-excessive-heat-6",
                  "type": "text",
                  "props": {
                    "text": "Catching these issues early can prevent a complete transmission breakdown.",
                    "align": "left",
                    "width": "full"
                  }
                },
