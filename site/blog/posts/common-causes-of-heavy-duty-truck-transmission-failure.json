                {
                  "id": "list-poor-maintenance-6",
                  "type": "prose-list",
                  "props": {
                    "ordered": false,
                    "items": [
                      {
                        "text": "Skipping scheduled service intervals"
                      },
                      {
                        "text": "Using the wrong transmission fluid"
                      },
                      {
                        "text": "Ignoring fluid leaks"
                      },
                      {
                        "text": "Running trucks with overheated systems"
                      }
                    ]
                  }
                },
                {
                  "id": "p-poor-maintenance-7",
                  "type": "text",
                  "props": {
                    "text": "Routine inspections and preventative service go a long way toward protecting the life of a super heavy-duty truck transmission.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-overloading",
                  "type": "heading",
                  "props": {
                    "text": "2. Overloading the Truck",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "overloading"
                  }
                },
                {
                  "id": "p-overloading-1",
                  "type": "text",
                  "props": {
                    "text": "Commercial trucks are designed to haul serious weight, but exceeding the recommended limits can place enormous stress on the drivetrain.",
