                        {
                          "id": "h-step-1",
                          "type": "heading",
                          "props": {
                            "text": "Kingpin and Fifth Wheel Connection",
                            "headingLevel": 2,
                            "align": "left",
                            "anchor": "step-1"
                          }
                        },
                        {
                          "id": "p-step-1",
                          "type": "text",
                          "props": {
                            "text": "The kingpin is what keeps your trailer securely locked into the tractor, and it's one of the most critical connection points in your entire setup. Before you leave, make sure the kingpin is not excessively worn or damaged, and verify that the fifth wheel jaws are fully closed and properly locked around it. Improper kingpin connections can lead to catastrophic trailer disconnects. Take the extra minute to double-check the coupling; you'll thank yourself later.",
                            "align": "left",
                            "width": "full"
                          }
                        }
                      ]
                    }
                  ]
                },
