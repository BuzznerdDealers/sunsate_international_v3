                {
                  "id": "p-why-matters-4",
                  "type": "text",
                  "props": {
                    "text": "Proper planning and preventive maintenance help reduce unexpected costs. For owner-operators, especially those running smaller fleets, avoiding downtime can make a major difference in yearly profitability.",
                    "align": "left",
                    "width": "full"
                  }
                },
