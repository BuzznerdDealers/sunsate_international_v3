                      "alt": "Sun State technician checking the glad hand connections on a dry van trailer"
                    }
                  }
                },
                {
                  "id": "h-rentals",
                  "type": "heading",
                  "props": {
                    "text": "Trailer Rentals: A Strategic Option for Growing Fleets",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "rentals"
                  }
                },
                {
                  "id": "p-rentals-1",
                  "type": "text",
                  "props": {
                    "text": "Short-term or seasonal needs don't always justify a full purchase. Trailer rentals can help:",
                    "align": "left",
