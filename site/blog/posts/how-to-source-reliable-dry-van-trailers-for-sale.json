                      },
                      {
                        "text": "Fuel efficiency impacts"
                      },
                      {
                        "text": "Resale or trade-in value"
                      }
                    ]
                  }
                },
                {
                  "id": "p-total-cost-3",
                  "type": "text",
                  "props": {
                    "text": "When it comes to trailer investments, planning ahead reduces downtime and protects margins.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-2",
                  "type": "image",
                  "props": {
                    "width": "full",
