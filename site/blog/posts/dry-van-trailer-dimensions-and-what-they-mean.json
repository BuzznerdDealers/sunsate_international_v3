                },
                {
                  "id": "p-new-vs-used-1",
                  "type": "text",
                  "props": {
                    "text": "The core dry van dimensions remain consistent whether you purchase new or used. However, material construction and overall weight efficiency can vary.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "cards-new-vs-used-2",
