                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "p-load-planning-2",
                  "type": "text",
                  "props": {
                    "text": "If you regularly haul palletized freight for distribution centers or big-box retailers, the 53-foot configuration gives you predictable capacity. That predictability helps with quoting jobs and calculating revenue per load. Even a few inches of additional interior clearance can make a difference when you're optimizing every cubic foot.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-1",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/dry-van-trailer-dimensions-and-what-they-mean/1.jpg",
                      "width": 1000,
                      "height": 667,
                      "alt": "Open rear doors of a Hyundai Translead dry van trailer showing the empty cargo interior"
                    }
                  }
                },
                {
                  "id": "h-not-only-answer",
                  "type": "heading",
                  "props": {
                    "text": "When 53' Dry Van Dimensions Aren't the Only Answer",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "not-only-answer"
                  }
                },
                {
                  "id": "p-not-only-answer-1",
                  "type": "text",
                  "props": {
                    "text": "While 53-foot trailers dominate the market, not every operation needs the largest configuration. Here are some other options that might be a better fit for your freight needs:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "cards-not-only-answer-2",
                  "type": "card-lists",
                  "props": {
                    "variant": "type",
                    "items": [
                      {
                        "title": "48-Foot Dry Vans",
                        "points": [
                          {
                            "text": "Still used in some regional fleets"
                          },
                          {
                            "text": "Typically carry about 24 pallets"
                          },
                          {
                            "text": "Best for heavier loads to not max out GVW"
                          }
                        ]
                      },
                      {
                        "title": "Specialized Dry Van Sizes",
                        "points": [
                          {
                            "text": "Urban deliveries"
                          },
                          {
                            "text": "Weight-restricted routes"
                          },
                          {
                            "text": "Specialized freight contracts"
                          }
                        ],
                        "intro": "Certain operations may choose shorter units for:"
                      }
                    ]
                  }
                },
                {
                  "id": "p-not-only-answer-3",
                  "type": "text",
                  "props": {
                    "text": "If you're running shorter regional routes or working with specific dock limitations, a 48-foot option could make sense. The key is matching dry van sizes to the type of freight and lanes you run most often.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "links-not-only-answer-4-row",
                  "type": "row",
                  "props": {
                    "gap": 0
                  },
                  "children": [
                    {
                      "id": "links-not-only-answer-4",
