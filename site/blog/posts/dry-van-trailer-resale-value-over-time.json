                {
                  "id": "p-protect-1",
                  "type": "text",
                  "props": {
                    "text": "If resale value matters to your business, it's something you need to plan for from day one. Here's what makes the biggest difference:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h3-protect-2",
                  "type": "heading",
                  "props": {
                    "text": "Stay Consistent With Maintenance",
                    "headingLevel": 3,
                    "align": "left"
                  }
                },
                {
                  "id": "p-protect-3",
                  "type": "text",
                  "props": {
                    "text": "Keep up with inspections, address small issues early, and maintain brakes, tires, and flooring.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h3-protect-4",
                  "type": "heading",
                  "props": {
                    "text": "Avoid Overloading",
                    "headingLevel": 3,
                    "align": "left"
                  }
                },
                {
                  "id": "p-protect-5",
                  "type": "text",
                  "props": {
                    "text": "Pushing a trailer beyond its intended limits accelerates wear and reduces long-term value.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h3-protect-6",
                  "type": "heading",
                  "props": {
                    "text": "Store Equipment Properly",
                    "headingLevel": 3,
                    "align": "left"
                  }
                },
                {
                  "id": "p-protect-7",
                  "type": "text",
                  "props": {
                    "text": "Whenever possible, protect trailers from excessive exposure to the elements.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-protect-8",
                  "type": "text",
                  "props": {
                    "text": "At <a href=\"/locations/trailer-sales\">Sun State Trailers</a>, we've seen firsthand how these habits extend both lifespan and resale value. It's not complicated, but it does require consistency.",
                    "align": "left",
                    "width": "full"
                  }
                },
