                      "alt": "Exterior of Sun State International Tampa service center"
                    }
                  }
                },
                {
                  "id": "h-get-back-on-road",
                  "type": "heading",
                  "props": {
                    "text": "Get Back On the Road With Confidence",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "get-back-on-road"
                  }
                },
                {
                  "id": "p-get-back-on-road-1",
                  "type": "text",
                  "props": {
                    "text": "Every mile you drive adds to your bottom line, but only if your truck is ready for the road ahead. A preventive maintenance plan ensures that you're not just reacting to problems but proactively protecting your business from them.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-get-back-on-road-2",
                  "type": "text",
                  "props": {
                    "text": "At Sun State International, we're here to help you minimize downtime, extend your truck's life, and keep your operations moving smoothly. Because when your truck runs better, your business does too.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "actions-get-back-on-road-3",
