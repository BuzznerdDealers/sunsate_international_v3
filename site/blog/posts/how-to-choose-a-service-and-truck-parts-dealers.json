                  "props": {
                    "text": "Signs You've Found the Right Truck Parts Dealer",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "signs"
                  }
                },
                {
                  "id": "p-signs-1",
                  "type": "text",
                  "props": {
                    "text": "Not sure if you've found the right fit? Here are a few signs:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-signs-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "You're not constantly dealing with repeat issues"
                      },
                      {
                        "text": "Parts arrive when expected"
                      },
                      {
                        "text": "Service appointments are efficient and organized"
                      },
                      {
                        "text": "You feel confident in their recommendations"
                      }
                    ]
                  }
                },
                {
                  "id": "p-signs-3",
                  "type": "text",
                  "props": {
                    "text": "When your dealer is doing their job right, your day runs smoother.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-2",
                  "type": "image",
                  "props": {
                    "width": "full",
