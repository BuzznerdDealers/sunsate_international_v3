                    }
                  ]
                },
                {
                  "id": "h-preventive-maintenance",
                  "type": "heading",
                  "props": {
                    "text": "Save Downtime With Preventive Maintenance",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "preventive-maintenance"
                  }
                },
                {
                  "id": "p-preventive-maintenance-1",
                  "type": "text",
                  "props": {
                    "text": "Most semi truck engine problems start small. Preventive maintenance helps fleets avoid major repairs by addressing issues before they cause costly downtime. Recommended PM checks:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-preventive-maintenance-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Oil and filter changes at OEM-recommended intervals"
                      },
                      {
                        "text": "Cooling system flushes before peak summer months"
                      },
                      {
                        "text": "Fuel filter replacements every 15,000–25,000 miles"
                      },
                      {
                        "text": "Regular diagnostics on sensors and electrical systems"
                      }
                    ]
                  }
                },
                {
                  "id": "h-why-choose-us",
                  "type": "heading",
                  "props": {
                    "text": "Why Choose Sun State International For Engine Service",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "why-choose-us"
                  }
                },
                {
                  "id": "p-why-choose-us-1",
                  "type": "text",
                  "props": {
                    "text": "Sun State International isn't just another shop. We are Florida's only International Truck dealer and a trusted partner for fleets across Tampa, Sarasota, and Davenport. What sets us apart:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-why-choose-us-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Certified technicians: factory-trained experts ready to handle simple fixes or complex overhauls"
                      },
                      {
