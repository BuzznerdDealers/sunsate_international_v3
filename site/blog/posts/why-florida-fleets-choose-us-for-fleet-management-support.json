                              {
                                "ctaId": "order-parts-online",
                                "label": "Visit Our Parts Department →",
                                "style": "link"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "h-built-for-florida",
                  "type": "heading",
                  "props": {
                    "text": "Florida Fleet Services Built for Real-World Conditions",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "built-for-florida"
                  }
                },
                {
                  "id": "p-built-for-florida-1",
                  "type": "text",
                  "props": {
                    "text": "Not all fleet strategies translate well to Florida. Heat, weather swings, and long-haul mileage require region-specific experience. That's where Florida fleet services make a difference. Sun State International's presence across key Florida markets allows fleets to:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "list-built-for-florida-2",
                  "type": "prose-list",
                  "props": {
                    "ordered": false,
                    "items": [
                      {
                        "text": "Access service and parts locally"
                      },
                      {
                        "text": "Maintain consistency across locations"
                      },
                      {
                        "text": "Reduce travel time for service needs"
                      }
                    ]
                  }
                },
                {
                  "id": "p-built-for-florida-3",
                  "type": "text",
                  "props": {
                    "text": "This regional support model helps fleets stay flexible without sacrificing reliability.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-why-fleets-choose-us",
                  "type": "heading",
                  "props": {
                    "text": "Why Fleets Choose Sun State International as Their Dealer Partner",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "why-fleets-choose-us"
                  }
                },
                {
                  "id": "p-why-fleets-choose-us-1",
                  "type": "text",
                  "props": {
                    "text": "Fleet owners value trust, accountability, and efficiency. They want partners who understand that every decision impacts drivers, schedules, and revenue. Sun State International stands out because:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-why-fleets-choose-us-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "We operate as a full-service truck dealer"
                      },
                      {
                        "text": "Parts and service teams work together, not in silos"
                      },
                      {
                        "text": "Support is straightforward and responsive"
                      },
                      {
                        "text": "Relationships are built for the long term, not one-time sales"
                      }
                    ]
                  }
                },
                {
                  "id": "p-why-fleets-choose-us-3",
                  "type": "text",
                  "props": {
                    "text": "Fleet management isn't about chasing the lowest upfront cost. It's about maximizing return over the life of every vehicle, something Sun State International helps fleets do every day.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-2",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/why-florida-fleets-choose-us-for-fleet-management-support/2.jpg",
                      "width": 1280,
                      "height": 853,
                      "alt": "Sun State International team members collaborating at the front desk"
                    }
                  }
                },
                {
                  "id": "h-smarter-approach",
                  "type": "heading",
                  "props": {
                    "text": "A Smarter Approach to Fleet Management Starts with the Right Dealer",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "smarter-approach"
                  }
                },
                {
                  "id": "p-smarter-approach-1",
                  "type": "text",
                  "props": {
                    "text": "Strong fleet management strategies rely on dependable equipment, consistent maintenance, and responsive support. By integrating parts, service, and dealership expertise, Sun State International helps fleets reduce downtime, manage costs, and plan for growth with confidence.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-smarter-approach-2",
                  "type": "text",
                  "props": {
                    "text": "If you're ready to simplify fleet management and work with a dealer that understands Florida fleet operations, contact Sun State International today to start the conversation.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "actions-smarter-approach-3",
                  "type": "buttons",
                  "props": {
