                  "id": "list-why-tampa-needs-parts-2",
                  "type": "prose-list",
                  "props": {
                    "ordered": false,
                    "items": [
                      {
                        "text": "Where can I find fair prices on OEM trailer components?"
                      },
                      {
                        "text": "Who can I trust to help me choose the right part the first time?"
                      },
                      {
                        "text": "What Tampa truck or trailer supply store has what I need in stock, without waiting weeks for shipping?"
                      }
                    ]
                  }
