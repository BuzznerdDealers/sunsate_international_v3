                          "type": "heading",
                          "props": {
                            "text": "Improve Compliance and Reporting",
                            "headingLevel": 3,
                            "align": "left"
                          }
                        },
                        {
                          "id": "numbered-benefits-5-p1",
                          "type": "text",
                          "props": {
                            "text": "Between DOT regulations, hours-of-service tracking, and IFTA reporting, staying compliant is a full-time job on its own. A fleet management system automates these tasks and helps ensure your records are accurate and up to date. With International trucks and OnCommand® services, much of this compliance data is generated automatically, giving you peace of mind and fewer administrative headaches.",
                            "align": "left",
                            "width": "full"
                          }
                        }
                      ]
