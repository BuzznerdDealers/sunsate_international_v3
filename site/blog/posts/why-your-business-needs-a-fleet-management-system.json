                      "children": [
                        {
                          "id": "numbered-benefits-2-h",
                          "type": "heading",
                          "props": {
                            "text": "Prevent Downtime With Predictive Maintenance",
                            "headingLevel": 3,
                            "align": "left"
                          }
                        },
                        {
                          "id": "numbered-benefits-2-p1",
                          "type": "text",
                          "props": {
                            "text": "Unexpected repairs cost more than just money; they cost time, customer satisfaction, and lost opportunities. With a fleet management system, you can identify small issues before they turn into expensive problems.",
                            "align": "left",
                            "width": "full"
                          }
                        },
                        {
                          "id": "numbered-benefits-2-p2",
                          "type": "text",
                          "props": {
                            "text": "International trucks equipped with OnCommand® Connection give you real-time access to diagnostic data, letting you schedule service before breakdowns happen. This predictive maintenance approach helps reduce downtime and extend the life of your vehicles.",
                            "align": "left",
                            "width": "full"
                          }
                        }
                      ]
                    }
                  ]
                },
