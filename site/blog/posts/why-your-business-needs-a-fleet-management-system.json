                        {
                          "id": "numbered-benefits-4-p1",
                          "type": "text",
                          "props": {
                            "text": "The insights you gain from a fleet management system can lead to significant cost savings. From improving fuel efficiency to identifying underperforming vehicles, you’ll know exactly where your money is going and how to save more of it. Fuel usage reports, idle time tracking, and route optimization features can all be used to tighten up inefficiencies and trim down overhead, making every dollar go further.",
                            "align": "left",
                            "width": "full"
                          }
                        }
                      ]
                    }
