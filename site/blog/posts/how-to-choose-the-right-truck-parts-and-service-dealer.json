                                "label": "Explore Our Parts Inventory →",
                                "style": "link"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "fig-1",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/how-to-choose-the-right-truck-parts-and-service-dealer/1.jpg",
                      "width": 1280,
                      "height": 853,
                      "alt": "Aisle of shelved truck parts and belts inside the Sun State International parts warehouse"
                    }
                  }
                },
                {
                  "id": "h3-what-to-look-for-5",
                  "type": "heading",
                  "props": {
                    "text": "Experienced Technicians Matter",
                    "headingLevel": 3,
                    "align": "left",
                    "anchor": "experienced-techs"
                  }
                },
                {
                  "id": "p-what-to-look-for-6",
                  "type": "text",
                  "props": {
                    "text": "A good repair experience starts with experienced technicians who understand commercial trucks inside and out. Truck technology continues to evolve. Diagnostics, emissions systems, electrical components, and preventative maintenance all require knowledgeable technicians with the right tools and training. At Sun State International, our service teams work on everything from routine maintenance to complex repairs.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "co-what-to-look-for-7-row",
                  "type": "row",
                  "props": {
                    "gap": 0
                  },
                  "children": [
                    {
                      "id": "co-what-to-look-for-7",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "styles": {
                        "base": {
                          "borderWidth": 1,
                          "borderStyle": "solid",
                          "borderColor": "line",
                          "paddingTop": 26,
                          "paddingRight": 28,
                          "paddingBottom": 26,
                          "paddingLeft": 28,
                          "marginTop": 8,
                          "marginBottom": 34
                        }
                      },
                      "children": [
                        {
                          "id": "co-what-to-look-for-7-cta",
                          "type": "buttons",
                          "props": {
                            "align": "left",
                            "items": [
                              {
                                "ctaId": "schedule-service",
                                "label": "Schedule Your Service Appointment →",
                                "style": "link"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "h3-what-to-look-for-8",
                  "type": "heading",
                  "props": {
                    "text": "Understands the Importance of Customer Service",
                    "headingLevel": 3,
                    "align": "left",
                    "anchor": "customer-service"
                  }
                },
                {
                  "id": "p-what-to-look-for-9",
                  "type": "text",
                  "props": {
                    "text": "In the trucking industry, relationships matter. The best dealerships understand that their customers are depending on them to keep their businesses operational. At Sun State International, customer service is at the center of everything we do. We're a family-owned company built on long-term relationships, honest communication, and dependable support.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-one-partner",
                  "type": "heading",
                  "props": {
                    "text": "Why Fleet Owners Choose One Full-Service Partner",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "one-partner"
                  }
                },
                {
                  "id": "p-one-partner-1",
                  "type": "text",
                  "props": {
                    "text": "One of the biggest frustrations for owner-operators is having to work with multiple vendors just to keep their fleet running. One shop handles repairs, another handles parts, and another schedules inspections. It wastes time and creates unnecessary headaches. That's why many companies are looking for a complete fleet repair and maintenance Florida provider that can handle everything under one roof.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h3-one-partner-2",
                  "type": "heading",
                  "props": {
                    "text": "Service, Parts, and Support in One Place",
                    "headingLevel": 3,
                    "align": "left",
                    "anchor": "service-parts-support"
                  }
                },
                {
                  "id": "p-one-partner-3",
                  "type": "text",
                  "props": {
                    "text": "Sun State International provides:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-one-partner-4",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "OEM and aftermarket truck parts"
                      },
                      {
                        "text": "Preventative maintenance"
                      },
                      {
                        "text": "Commercial truck diagnostics"
                      },
                      {
                        "text": "Brake service and repairs"
                      },
                      {
                        "text": "Electrical troubleshooting"
                      },
                      {
                        "text": "DOT inspections"
                      },
                      {
                        "text": "Cooling system repairs"
                      },
                      {
                        "text": "Fleet maintenance support"
                      },
                      {
                        "text": "Truck service and repair for all makes and models"
                      }
                    ]
                  }
                },
                {
                  "id": "p-one-partner-5",
                  "type": "text",
                  "props": {
                    "text": "Having one trusted team manage your truck parts and service simplifies communication and helps your operation run more efficiently.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-2",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/how-to-choose-the-right-truck-parts-and-service-dealer/2.jpg",
                      "width": 1280,
                      "height": 853,
                      "alt": "Parts counter employee looking up an International parts catalog on dual monitors"
                    }
                  }
                },
                {
                  "id": "h3-one-partner-6",
                  "type": "heading",
                  "props": {
                    "text": "Preventative Maintenance Saves Money",
                    "headingLevel": 3,
                    "align": "left",
                    "anchor": "preventative-maintenance"
                  }
                },
                {
                  "id": "p-one-partner-7",
                  "type": "text",
                  "props": {
                    "text": "Many major truck repairs start as small problems that were ignored for too long. Preventative maintenance helps reduce breakdowns, improve fuel efficiency, and extend vehicle lifespan. Routine fleet service appointments can help identify:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "list-one-partner-8",
                  "type": "prose-list",
                  "props": {
                    "ordered": false,
                    "items": [
                      {
                        "text": "Brake wear"
                      },
                      {
                        "text": "Fluid leaks"
                      },
                      {
                        "text": "Tire issues"
                      },
                      {
                        "text": "Electrical problems"
                      },
                      {
                        "text": "Cooling system concerns"
                      },
                      {
                        "text": "Suspension wear"
                      }
                    ]
                  }
                },
                {
                  "id": "p-one-partner-9",
                  "type": "text",
                  "props": {
                    "text": "For fleet owners, preventative maintenance is one of the smartest long-term investments you can make.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h3-one-partner-10",
                  "type": "heading",
                  "props": {
                    "text": "Online Parts Ordering Makes Fleet Management Easier",
                    "headingLevel": 3,
                    "align": "left",
                    "anchor": "online-ordering"
                  }
                },
                {
                  "id": "p-one-partner-11",
                  "type": "text",
                  "props": {
                    "text": "Today's fleet owners need convenience just as much as quality service. That's why having access to an online parts store along with in-person parts and service departments can save valuable time during busy workweeks. Instead of calling multiple locations or searching for availability, fleet managers can quickly locate the truck parts they need and keep operations moving.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-3",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/how-to-choose-the-right-truck-parts-and-service-dealer/3.jpg",
                      "width": 1280,
                      "height": 853,
                      "alt": "Exterior of the Sun State International service center with fleet vehicles parked outside"
                    }
                  }
                },
                {
                  "id": "h-right-dealer",
                  "type": "heading",
                  "props": {
                    "text": "How to Know You've Found the Right Dealer",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "right-dealer"
                  }
                },
                {
                  "id": "p-right-dealer-1",
                  "type": "text",
                  "props": {
                    "text": "The right dealership should feel like a partner, not just another vendor. They should communicate clearly, follow through on commitments, and understand the realities of running a trucking business. Here are a few signs you're working with the right commercial fleet service provider:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-right-dealer-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "They prioritize quick turnaround times"
                      },
                      {
                        "text": "They communicate honestly about repairs and timelines"
                      },
                      {
                        "text": "They stock quality OEM parts"
                      },
                      {
                        "text": "They understand fleet operations"
                      },
                      {
                        "text": "They make scheduling service easy"
                      },
                      {
                        "text": "They value long-term relationships"
                      }
                    ]
                  }
                },
                {
                  "id": "p-right-dealer-3",
                  "type": "text",
                  "props": {
                    "text": "At Sun State International, those principles guide everything we do.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-keep-moving",
                  "type": "heading",
                  "props": {
                    "text": "Keep Your Fleet Moving With Sun State International",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "keep-moving"
                  }
                },
                {
                  "id": "p-keep-moving-1",
                  "type": "text",
                  "props": {
                    "text": "Finding dependable truck parts and service shouldn't be complicated. Whether you need preventative maintenance, fleet repairs, or OEM truck parts, having the right team behind you makes all the difference. If your fleet needs repairs, preventative maintenance, or diagnostics, schedule a service appointment with Sun State International today. Our team is here to help keep your trucks on the road and your business moving forward.",
                    "align": "left",
                    "width": "full"
                  }
                },
