                  "props": {
                    "text": "When you choose Sun State Trailers, you get more than a trailer dealer to work with. You get a partner that's Florida-based and relationship-driven. Our team pairs straightforward guidance with on-the-ground inventory so you can make fast, confident decisions.",
                    "align": "left",
