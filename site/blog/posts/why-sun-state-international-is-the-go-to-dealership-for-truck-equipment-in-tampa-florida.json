                        }
                      },
                      "children": [
                        {
                          "id": "co-turnaround-2-cta",
                          "type": "buttons",
                          "props": {
                            "align": "left",
                            "items": [
                              {
                                "ctaId": "schedule-service",
                                "label": "Schedule a Service Appointment →",
                                "style": "link"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "h-trusted",
                  "type": "heading",
                  "props": {
                    "text": "Trusted by Businesses Across Florida",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "trusted"
                  }
                },
                {
                  "id": "p-trusted-1",
                  "type": "text",
                  "props": {
                    "text": "Over the years, we’ve built strong relationships with contractors, logistics companies, government agencies, and independent drivers throughout the region. Why? Because they know we deliver on our word. When customers come to <a href=\"/\">Sun State International</a>, they’re not just looking for equipment—they’re looking for a dealership they can count on. And that’s exactly what we provide: dependable service, high-quality gear, and long-term support that makes a difference.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-success",
                  "type": "heading",
                  "props": {
                    "text": "Building Your Success Mile After Mile",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "success"
                  }
                },
                {
                  "id": "p-success-1",
                  "type": "text",
                  "props": {
                    "text": "If you’re searching for reliable, professional, and customer-first support for <a href=\"/parts\">truck equipment</a> in Tampa, Florida, look no further than <a href=\"/\">Sun State International</a>. Whether you’re expanding your fleet, upgrading your trucks, or just need the right equipment for the job, our team is here to help you move forward. When you work with <a href=\"/\">Sun State</a>, you’re not just buying parts—you’re building a partnership that supports your success mile after mile. Ready to outfit your fleet? <a href=\"/contact\">Contact Sun State International</a> today or stop by one of our <a href=\"/locations/tampa\">Tampa</a>, <a href=\"/locations/sarasota\">Sarasota</a>, or <a href=\"/locations/davenport\">Davenport</a> locations to see how we can help.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "actions-success-2",
                  "type": "buttons",
                  "props": {
