                        },
                        {
                          "id": "qa-body",
                          "type": "text",
                          "props": {
                            "text": "Prioritize safety, efficiency and reliability: advanced camera and collision avoidance systems, adaptive cruise control, a fuel-efficient engine with electronic logging, modern emergency air brake systems, ergonomic seating and cabin layout, tire pressure monitoring, a strong manufacturer warranty, and OnCommand Connection fleet health monitoring.",
                            "align": "left",
                            "width": "full",
                            "anchor": "post-answer"
                          },
                          "styles": {
