                    "width": "full",
                    "anchor": "post-lede"
                  }
                },
                {
                  "id": "p-intro-1",
                  "type": "text",
                  "props": {
                    "text": "At <a href=\"/locations/trailer-sales\">Sun State Trailers</a>, we understand that every hour your trailer is out of service affects productivity and profitability. That's why we've built our business around providing quality parts, expert repairs, and dependable customer service that keeps commercial trailers on the road.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-intro-2",
                  "type": "text",
                  "props": {
