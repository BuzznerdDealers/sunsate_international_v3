                {
                  "id": "h-local-trust",
                  "type": "heading",
                  "props": {
                    "text": "Florida Drivers Need Local Truck Repair They Can Trust",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "local-trust"
                  }
                },
                {
                  "id": "p-local-trust-1",
                  "type": "text",
                  "props": {
                    "text": "When a breakdown happens on I-4, US-301, or anywhere in between, you don't have time to gamble with an unreliable shop. That's why local experience matters. Sun State International has spent decades serving Florida's trucking community, and we know the unique challenges our drivers face.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-local-trust-2",
                  "type": "text",
                  "props": {
                    "text": "Searching online for truck repair in Tampa, FL, will give you a dozen options, but not all shops are equipped to handle today's advanced systems or provide manufacturer-backed care. Sun State International is fully certified and authorized to service International® brand trucks, giving you confidence that the work is done right the first time.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-what-to-expect",
                  "type": "heading",
                  "props": {
                    "text": "What You Can Expect From a Service Appointment at Sun State International",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "what-to-expect"
                  }
                },
                {
                  "id": "features-what-to-expect-1",
                  "type": "list",
                  "props": {
                    "headingLevel": 2,
                    "columns": 2,
                    "items": [
                      {
                        "label": "1. Straightforward Check-In & Clear Expectations",
                        "desc": "We respect your time. You'll get accurate diagnostics and an honest service timeline so you can plan around your routes."
                      },
                      {
                        "label": "2. Transparent Communication",
                        "desc": "We'll never upsell you on unnecessary repairs. Our priority is helping you make informed decisions based on safety and long-term performance."
                      },
                      {
                        "label": "3. Quality Parts & OEM Standards",
                        "desc": "We use genuine International® parts whenever possible to protect your investment and keep your truck running at peak performance."
                      },
                      {
                        "label": "4. A Team That Cares About Your Success",
                        "desc": "From technicians to service advisors, our team cares about your business just as much as you do. Your truck isn't just a vehicle; it's how you provide for your family and run your company."
                      }
                    ]
