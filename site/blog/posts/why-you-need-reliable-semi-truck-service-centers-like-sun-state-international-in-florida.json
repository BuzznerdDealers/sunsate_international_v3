                },
                {
                  "id": "h-why-choose-us",
                  "type": "heading",
                  "props": {
                    "text": "Why Trucking Businesses Choose Sun State International",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "why-choose-us"
                  }
                },
                {
                  "id": "p-why-choose-us-1",
                  "type": "text",
                  "props": {
                    "text": "At Sun State International, customer care isn't a sales pitch; it's how we've operated since day one. Our brand promise is rooted in hospitality, professionalism, and dependability. As a family-owned business, we know our customers by name, and we treat every truck like it's part of our own fleet. Across our Florida locations, drivers count on us because we offer:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-why-choose-us-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Reliable, certified truck technicians"
                      },
                      {
                        "text": "Proven expertise with International® trucks"
                      },
                      {
                        "text": "A straightforward, respectful service experience"
                      },
                      {
                        "text": "Quick turnaround times"
                      },
                      {
                        "text": "A commitment to long-term relationships"
                      }
                    ]
                  }
                },
