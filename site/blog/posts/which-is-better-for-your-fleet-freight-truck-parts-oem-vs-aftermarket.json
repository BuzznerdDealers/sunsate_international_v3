                },
                {
                  "id": "h-long-term",
                  "type": "heading",
                  "props": {
                    "text": "Preparing for Long-Term Success",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "long-term"
                  }
                },
                {
                  "id": "p-long-term-1",
                  "type": "text",
                  "props": {
                    "text": "Choosing between OEM and <a href=\"/aftermarket\">aftermarket fleet freight truck parts</a> doesn’t have to feel like a gamble. At <a href=\"/\">Sun State International</a>, we’ll help you make the best decision for your fleet. Because keeping your fleet moving isn’t just about <a href=\"/parts\">buying parts</a>—it’s about building a smart, reliable strategy for long-term success. Need guidance on the right parts for your truck? Visit <a href=\"/contact\">Sun State International or give us a call</a> — we’ll help you get back on the road with confidence.",
                    "align": "left",
                    "width": "full"
                  }
                },
