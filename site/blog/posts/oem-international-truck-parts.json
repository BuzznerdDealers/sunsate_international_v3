                },
                {
                  "id": "p-biggest-impact-1",
                  "type": "text",
                  "props": {
                    "text": "Not every part carries the same level of risk. But there are certain components where OEM is the clear choice:",
                    "align": "left",
                    "width": "full"
                  }
