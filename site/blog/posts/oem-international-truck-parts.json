                      },
                      {
                        "text": "Braking systems"
                      }
                    ]
                  }
                },
                {
                  "id": "p-biggest-impact-3",
                  "type": "text",
                  "props": {
                    "text": "These are areas where performance and safety matter most. Using OEM international truck parts helps you avoid costly mistakes.",
                    "align": "left",
                    "width": "full"
                  }
                },
