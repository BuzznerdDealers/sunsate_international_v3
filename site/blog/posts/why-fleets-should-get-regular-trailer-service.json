                        "text": "Tire wear patterns"
                      },
                      {
                        "text": "Inflation levels"
                      },
                      {
                        "text": "Wheel bearings"
                      },
                      {
                        "text": "Hubs"
                      },
                      {
                        "text": "Lug nuts"
                      },
                      {
                        "text": "Wheel seals"
                      }
                    ]
                  }
                },
                {
                  "id": "h3-included-9",
                  "type": "heading",
                  "props": {
                    "text": "Lighting and Electrical Systems",
                    "headingLevel": 3,
                    "align": "left"
                  }
                },
                {
                  "id": "p-included-10",
                  "type": "text",
                  "props": {
                    "text": "Damaged wiring or burned-out lights can quickly result in DOT violations. Every service visit should include testing:",
                    "align": "left",
