                  }
                },
                {
                  "id": "p-included-13",
                  "type": "text",
                  "props": {
                    "text": "Frames, crossmembers, landing gear, doors, and coupling equipment are inspected for signs of damage, corrosion, or excessive wear that could affect safe operation.",
                    "align": "left",
