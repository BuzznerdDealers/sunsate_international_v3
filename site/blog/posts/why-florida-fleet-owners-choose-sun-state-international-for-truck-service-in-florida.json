                {
                  "id": "h-how-it-works",
                  "type": "heading",
                  "props": {
                    "text": "How Florida Fleet Owners Work With Us",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "how-it-works"
                  }
                },
                {
                  "id": "steps-how-it-works-1",
                  "type": "step-list",
                  "props": {
                    "items": [
                      {
                        "num": "1",
                        "title": "Call or request a slot",
                        "text": "Start with your preferred location and share unit details, symptoms, and urgency. Tampa, Davenport, and Sarasota run extended weekday service hours, and Brooksville focuses on parts support."
                      },
                      {
                        "num": "2",
                        "title": "Get a clear estimate",
                        "text": "We explain findings in plain language with options that balance speed and cost. No surprises."
                      },
                      {
                        "num": "3",
                        "title": "Approve the repair plan",
                        "text": "We move forward once you're confident in the scope and the cost, with clear communication throughout."
                      },
                      {
                        "num": "4",
                        "title": "Roll out with paperwork that helps",
                        "text": "You leave with documentation for compliance, warranty, and internal reporting."
                      }
                    ]
                  }
                },
                {
                  "id": "h-faqs",
                  "type": "heading",
                  "props": {
                    "text": "FAQs for Florida Fleets",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "faqs"
                  }
                },
                {
                  "id": "questions-faqs-1",
                  "type": "qa-list",
                  "props": {
                    "items": [
                      {
                        "q": "Do you service non-International trucks?",
                        "a": "Yes. We support all makes of fleets for preventative maintenance, diagnostics, and major repairs."
                      },
                      {
                        "q": "Can you help reduce repeat breakdowns?",
                        "a": "Yes. Our advisors will build a preventative maintenance schedule tied to your duty cycles and OEM guidance, then track outcomes so you can see the impact on uptime and cost per mile."
                      },
                      {
                        "q": "What about emergency support?",
                        "a": "Call your nearest location for immediate guidance. After-hours coverage is available through Certified Fleet in specific markets."
                      }
                    ]
                  }
                },
                {
                  "id": "h-ready-to-schedule",
                  "type": "heading",
                  "props": {
                    "text": "Ready to Schedule Truck Service in Florida?",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "ready-to-schedule"
                  }
                },
                {
                  "id": "p-ready-to-schedule-1",
                  "type": "text",
                  "props": {
                    "text": "Sun State International is family-owned and Florida-focused. Our expert team is trained to be hospitable, professional, and dependable, which shows up in faster turnarounds and straight answers. Keep your routes on time with a service partner that respects your schedule and your bottom line. Schedule your service now with Sun State International.",
                    "align": "left",
                    "width": "full"
