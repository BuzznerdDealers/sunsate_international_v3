                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "p-causes-4",
                  "type": "text",
                  "props": {
                    "text": "Proper tire inspections and maintenance play a major role in improving roadway safety. The good news is that many blowouts can be prevented with a strong trailer preventive maintenance checklist and consistent service routines.",
                    "align": "left",
                    "width": "full"
                  }
                },
