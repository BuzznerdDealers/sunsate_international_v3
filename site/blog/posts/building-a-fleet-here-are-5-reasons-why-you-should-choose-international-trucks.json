                },
                {
                  "id": "p-satisfaction-1",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"/\">Sun State International</a> is more than just a dealership—we’re your partner in success. Our commitment to customer satisfaction is evident in every aspect of our business, from our knowledgeable sales team to our dedicated service professionals. We take the time to understand your unique needs and provide personalized solutions that drive results.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "p-satisfaction-2",
                  "type": "text",
                  "props": {
                    "text": "We believe in building lasting relationships with our customers by delivering consistent, high-quality support at every touchpoint. Whether you’re buying one truck or an entire fleet, you can trust that we’ll be there to help you every step of the way.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-trust",
                  "type": "heading",
                  "props": {
                    "text": "A Brand with Proven Trust",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "trust"
                  }
                },
                {
                  "id": "p-trust-1",
                  "type": "text",
                  "props": {
                    "text": "International Trucks have been a staple in the trucking industry for over a century, known for their reliability and resilience. This long-standing reputation means you’re not just buying a truck—you’re investing in a brand trusted by thousands of businesses across North America.",
                    "align": "left",
                    "width": "full"
                  }
                },
