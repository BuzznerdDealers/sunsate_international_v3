                  ]
                },
                {
                  "id": "fig-2",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/what-to-expect-from-an-international-truck-service-center/2.jpg",
                      "width": 1280,
