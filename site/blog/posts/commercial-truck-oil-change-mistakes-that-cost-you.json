                          "marginTop": 8,
                          "marginBottom": 34
                        }
                      },
                      "children": [
                        {
                          "id": "co-mistake-3-4-cta",
                          "type": "buttons",
                          "props": {
                            "align": "left",
                            "items": [
                              {
                                "ctaId": "order-parts-online",
