                        "b": "Up to ~45,000 lbs",
                        "c": "Slightly less than 53 ft",
                        "d": "Lower capacity"
                      },
                      {
                        "a": "Best Use",
                        "b": "Long-haul, high-volume loads",
                        "c": "Regional routes, tighter spaces",
                        "d": "LTL freight, short hauls"
                      },
                      {
