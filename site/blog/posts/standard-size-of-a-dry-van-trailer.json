                        "d": "Highest"
                      },
                      {
                        "a": "Common Industries",
                        "b": "Retail, manufacturing, distribution",
                        "c": "Regional delivery, mixed freight",
                        "d": "LTL, parcel, hub-and-spoke"
                      },
                      {
                        "a": "Availability",
