                },
                {
                  "id": "h-signs",
                  "type": "heading",
                  "props": {
                    "text": "Common Signs It's Time for Service",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "signs"
                  }
                },
                {
                  "id": "p-signs-1",
                  "type": "text",
                  "props": {
                    "text": "Even with a reliable preventive maintenance schedule for semi trucks, certain warning signs mean it's time for service now, not later:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-signs-2",
                  "type": "check-list",
                  "props": {
                    "items": [
                      {
                        "text": "Unusual engine sounds or vibrations"
                      },
                      {
                        "text": "Reduced fuel efficiency"
                      },
                      {
                        "text": "Difficulty shifting gears or sluggish acceleration"
                      },
                      {
                        "text": "Brake squealing or longer stopping distances"
                      },
                      {
                        "text": "Warning lights on the dashboard"
                      }
                    ]
                  }
                },
                {
                  "id": "p-signs-3",
                  "type": "text",
                  "props": {
                    "text": "Ignoring these signals can lead to expensive component failure. Regular checkups from trained technicians ensure your trucks meet the high standards you and your customers depend on.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "fig-1",
                  "type": "image",
                  "props": {
                    "width": "full",
                    "image": {
                      "src": "/img/blog/preventive-maintenance-schedule-for-semi-trucks/1.jpg",
                      "width": 1280,
