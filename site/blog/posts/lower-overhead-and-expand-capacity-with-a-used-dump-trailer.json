                {
                  "id": "h-lower-cost",
                  "type": "heading",
                  "props": {
                    "text": "Lower Upfront Cost, Faster ROI",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "lower-cost"
                  }
                },
                {
                  "id": "p-lower-cost-1",
                  "type": "text",
                  "props": {
                    "text": "When you purchase a used dump trailer, you're reducing the amount of capital tied up in equipment. That means:",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "checks-lower-cost-2",
                  "type": "check-list",
                  "props": {
                    "mark": "dot",
                    "items": [
                      {
                        "text": "Lower monthly payments, or none at all if purchasing outright"
                      },
                      {
                        "text": "Faster break-even point on jobs"
                      },
                      {
                        "text": "More flexibility to reinvest in labor, maintenance, or additional equipment"
                      }
                    ]
                  }
                },
                {
                  "id": "p-lower-cost-3",
                  "type": "text",
                  "props": {
                    "text": "In short, you start seeing a return sooner, which improves overall trailer ROI.",
                    "align": "left",
                    "width": "full"
