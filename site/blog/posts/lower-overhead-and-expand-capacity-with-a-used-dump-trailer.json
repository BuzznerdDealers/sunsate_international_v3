                {
                  "id": "p-supported-4",
                  "type": "text",
                  "props": {
                    "text": "That level of transparency builds trust, and trust is what keeps customers coming back.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "h-roi",
                  "type": "heading",
