                  "id": "p-capacity-1",
                  "type": "text",
                  "props": {
                    "text": "Not every job requires a brand-new trailer. Many contractors only need additional dump capacity during peak seasons or for specific projects. A dump trailer for sale on the used market allows you to scale up without locking yourself into long-term financial pressure.",
                    "align": "left",
                    "width": "full"
                  }
                },
