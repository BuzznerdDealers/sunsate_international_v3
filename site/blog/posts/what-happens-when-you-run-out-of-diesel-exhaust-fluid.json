                      "alt": "Technician using a wrench during commercial truck diesel repair service"
                    }
                  }
                },
                {
                  "id": "h-need-service",
                  "type": "heading",
                  "props": {
                    "text": "Need Reliable Commercial Truck Service?",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "need-service"
                  }
                },
                {
                  "id": "p-need-service-1",
                  "type": "text",
                  "props": {
                    "text": "When DEF issues happen, speed matters. Waiting days for diagnostics or parts can put your business behind schedule and create unnecessary stress for drivers and fleet managers. At Sun State International, we provide dependable support for fleets and owner-operators across Florida through our parts and service department. Whether you need diesel exhaust system repair, diagnostics, or replacement diesel fuel system parts, our team is here to help.",
                    "align": "left",
                    "width": "full"
                  }
                },
                {
                  "id": "co-need-service-2-row",
                  "type": "row",
                  "props": {
                    "gap": 0
                  },
                  "children": [
                    {
                      "id": "co-need-service-2",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "styles": {
