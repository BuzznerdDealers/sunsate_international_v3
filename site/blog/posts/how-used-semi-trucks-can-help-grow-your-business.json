                },
                {
                  "id": "h-backed",
                  "type": "heading",
                  "props": {
                    "text": "Your Business, Backed by Sun State",
                    "headingLevel": 2,
                    "align": "left",
                    "anchor": "backed"
                  }
                },
                {
                  "id": "p-backed-1",
                  "type": "text",
                  "props": {
                    "text": "When you buy a used truck from <a href=\"/\">Sun State International</a>, you’re not just buying a vehicle—you’re gaining a trusted partner. From <a href=\"/service\">preventive maintenance to parts and repairs</a>, we offer long-term support to help you get the most out of your investment. We’ve built our reputation by standing behind the fleets we serve. Our team knows trucks inside and out, and we’re committed to helping your business run better and grow smarter.",
                    "align": "left",
                    "width": "full"
                  }
                },
