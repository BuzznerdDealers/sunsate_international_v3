    {
      "id": "home-services",
      "type": "sharedSection",
      "props": {
        "sectionId": "service-rows",
        "values": {
          "eyebrow": "OUR INVENTORY",
          "heading": "Everything to keep you moving.",
          "body": "We make finding the right equipment from reputable brands easier than ever at Sun State International. Whether you need a commercial truck, trailer, or school bus, we have the equipment you need to keep your business moving.",
          "background": "card",
          "anchor": "services",
          "items": [
            {
              "num": "01",
              "title": "Trucks",
              "body": "Shop our wide selection of new and International trucks built to handle any job, equipped with advanced telematics via OnCommand Connection for real-time fleet insights.",
              "linkLabel": "Browse trucks →",
              "linkUrl": "/store/inventory?type=truck"
            },
            {
              "num": "02",
              "title": "Trailers",
              "body": "Explore our diverse inventory of trailers, including flatbeds, dump trailers, and reefers, from trusted brands like Hyundai Translead and Globe Trailers.",
              "linkLabel": "Browse trailers →",
              "linkUrl": "/store/inventory?type=trailer"
            },
            {
              "num": "03",
              "title": "IC Bus",
              "body": "Built for safety and reliability, our IC Bus selection offers top-of-the-line school and commercial buses from industry-leading manufacturers.",
              "linkLabel": "Browse buses →",
              "linkUrl": "/store/inventory?type=bus"
            },
            {
              "num": "04",
              "title": "Capacity Yard Trucks",
              "body": "Capacity yard trucks deliver the reliability and power your business needs to run smoothly day after day.",
              "linkLabel": "Explore models →",
              "linkUrl": "/capacity-yard-trucks"
            },
            {
              "num": "05",
              "title": "Service",
              "body": "We offer full-service repairs for trucks and trailers at our Diamond Edge certified service centers, plus mobile maintenance support so we come to you.",
              "linkLabel": "Schedule service →",
              "linkUrl": "/service-appointment"
            },
            {
              "num": "06",
              "title": "Parts",
              "body": "Order genuine parts online or in-store, with same-day pickup at our Aftermarket Parts and Truck & Trailer Parts locations.",
              "linkLabel": "Order parts →",
              "linkUrl": "/parts"
            },
            {
              "num": "07",
              "title": "Financing",
              "body": "Get financing options for your next truck or trailer purchase, with a team ready to walk you through it.",
              "linkLabel": "Learn more →",
              "linkUrl": "/financing"
            }
          ]
        }
