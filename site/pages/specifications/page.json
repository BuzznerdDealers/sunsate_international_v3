                  "props": {
                    "widget": "faq",
                    "config": {
                      "items": [
                        {
                          "q": "What is the International S13 Integrated Powertrain?",
                          "a": "The S13 is an engine, transmission and aftertreatment system designed to work as one. It is simple, easy to service, and delivers stellar performance with superior operating economy. Spec sheets are available for the LT and RH Series and the HX Series."
                        },
                        {
                          "q": "Which trucks can be ordered with the S13?",
                          "a": "The S13 Integrated Powertrain is offered on the International LT Series, RH Series and HX Series. Download the matching spec sheet or call 800-741-7566 and we will spec a unit for your application."
                        },
                        {
                          "q": "Which International series brochures are available?",
                          "a": "MV Series (including van, utility, recovery, boom and snowplow spec sheets), eMV Series, HV Series (HV509, HV515, HV609, HV615), LT Series, RH Series, HX Series (HX520, HX620), CV Series and LoneStar."
                        },
                        {
                          "q": "Are the brochures free to download?",
                          "a": "Yes. Every brochure and spec sheet on this page is a free PDF download. No form or registration is required."
                        },
                        {
                          "q": "How does International compare to competitors?",
                          "a": "Competitive comparison sheets are available for the CV, HX and LT Series, showing how International stacks up against comparable models."
                        },
                        {
                          "q": "Where can I get trailer specifications?",
                          "a": "Trailer specifications for Hyundai Translead and Globe Trailers are available through Sun State Trailers, or call Trailer Sales at (813) 621-1331 and we will send the spec sheet for the configuration you need."
                        }
                      ]
                    },
                    "snapshot": null
                  }
                }
              ]
            }
