    {
      "id": "inv-faq",
      "type": "sharedSection",
      "props": {
        "sectionId": "feature-grid",
        "values": {
          "eyebrow": "INVENTORY FAQS",
          "heading": "Common questions.",
          "span": 12,
          "background": "paper",
          "anchor": "inv-faq",
          "items": [
            {
              "title": "What does Sun State sell?",
              "body": "New and used International trucks, IC Bus, Capacity yard trucks, and new and used Hyundai Translead and Globe trailers including dry van, reefer and flatbed. Trailer rentals are also available through Sun State Trailers."
            },
            {
              "title": "Where is the inventory located?",
              "body": "Units are held across Tampa, Davenport and Sarasota, with trailer sales at 6020 Adamo Drive in Tampa. Call 800-741-7566 and we will confirm which location has the unit you are looking at and whether it can be moved."
            },
            {
              "title": "Can I order a truck that isn't in stock?",
              "body": "Yes. Build a spec in the truck configurator or tell us the application, and we will quote a factory order with a current lead time, or find a comparable unit already in stock or in transit."
            },
            {
              "title": "Do you rent trailers?",
              "body": "Yes. Sun State Trailers offers trailer rentals in addition to new and used trailer sales. Call Trailer Sales at (813) 621-1331 for availability."
            },
            {
              "title": "Can inventory be financed?",
              "body": "Yes. With a minimum down payment and approved credit we arrange financing through BMO Harris Bank, Navistar Financial and other sources, and can include parts, accessories, insurance and extended coverage in one monthly payment."
            },
            {
              "title": "Can you upfit a unit before delivery?",
              "body": "Yes. Our Tampa aftermarket facility installs bodies, roll-off hoists, liftgates, tarp systems, lift axles, PTO and wet-line kits and performs frame modifications, so the unit arrives ready to work."
            }
          ]
        }
      }
    },
