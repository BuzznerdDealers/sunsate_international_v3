      "props": {
        "sectionId": "feature-grid",
        "values": {
          "eyebrow": "QUICK ANSWERS",
          "heading": "Who to ask for at Sun State.",
          "span": 6,
          "background": "paper",
          "anchor": "team-faq",
          "items": [
            {
              "title": "Who is the CEO of Sun State International Trucks?",
              "body": "Oscar Horton is CEO. Miriam Horton is VP and Anthony Martell is COO."
            },
            {
              "title": "Who do I contact about buying a trailer?",
              "body": "Scott Anderson is Truck & Trailer Sales Manager and Debbie Hall handles New Truck and Globe Trailer sales. Sun State Trailers sells Hyundai Translead and Globe Trailers from the Tampa and Davenport locations."
            },
            {
              "title": "Who manages parts and service at each location?",
              "body": "Jason Velez in Tampa, Paul Royals in Davenport, Mike Velez in Sarasota, Ronnie Jones in Brooksville and Damian Groene at the Tampa Aftermarket center."
            },
            {
              "title": "Where is the Sun State team located?",
              "body": "Six Florida locations: Tampa (6020 E Adamo Dr), Sarasota (1000 Sarasota Center Blvd), Davenport (41609 Hwy 27), Brooksville (17127 Runway Drive), Tampa Aftermarket Parts (7105 E 6th Ave) and Trailer Sales in Tampa."
            }
          ]
        }
      },
