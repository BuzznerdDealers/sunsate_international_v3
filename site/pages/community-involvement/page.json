        "values": {
          "eyebrow": "WHY WE GIVE",
          "heading": "More than a business; a family.",
          "body": "At Sun State, we're more than a business; we're a family. Within our tight-knit community, every individual is not merely an employee but a valued member. We ensure every member of our team is cared for and respected as they are an essential part of our success.\n\nOur family-owned business has a heritage of community service and \"be the change\" care, and we seek to create the next generation of leaders in our region. That begins inside our own walls — and carries into the neighborhoods our trucks and trailers run through every day.",
          "background": "paper",
          "image": {
            "src": "https://vendure.buzznerdrv.com/assets/source/5c/teamwork-1.jpg",
            "alt": "Sun State employees volunteering ",
            "width": 2560,
            "height": 1707
