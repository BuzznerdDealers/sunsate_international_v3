                      "items": [
                        {
                          "q": "What is the main phone number for Sun State?",
                          "a": "Call 800-741-7566 and we'll route you to the right department, or email e-contact@sunstateintl.com. Direct numbers for sales, parts, service, aftermarket and trailer sales are listed on this page."
                        },
                        {
                          "q": "Who do I call if my truck is down after hours?",
                          "a": "Certified Fleet provides after-hours service from 8:00 PM to 5:00 AM at (863) 880-2206. Mobile service runs from Tampa, Sarasota and Davenport Monday through Friday, 8 AM to 5 PM."
                        },
                        {
                          "q": "How do I schedule a service appointment?",
                          "a": "Submit the online service appointment request, or call the service department at your location: Tampa (813) 521-8053, Sarasota (941) 541-3251, Davenport (863) 238-2939."
                        },
                        {
                          "q": "Who handles financing questions?",
                          "a": "Talk to Lynn DeJesus at (800) 741-7566 or (813) 621-1331 ext. 1008, or email a completed credit application to Lynn.DeJesus@sunstateintl.com."
                        },
                        {
                          "q": "How do I order parts?",
                          "a": "Call the parts counter at your nearest location, or order through the online parts store at sunstateparts.com for in-store pickup or delivery."
                        },
                        {
                          "q": "How quickly will you respond to a message?",
                          "a": "Messages submitted during business hours are typically answered the same business day. Messages sent overnight or on weekends are handled the next business morning."
                        }
                      ]
                    },
