    {
      "id": "appt-mobile",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "MOBILE SERVICE",
          "heading": "Or we come to you.",
          "body": "Whether you're stuck roadside or at a job site, our mobile technicians provide efficient, on-the-spot repairs to minimize downtime. Many repairs, diagnostics and preventative maintenance can be performed at your location without transporting the unit.\n\nChoose \"Mobile service at my location\" on the request form and add your service address, or call 800.741.7566 to dispatch a truck.",
          "ctaLabel": "Learn more about mobile service →",
          "ctaUrl": "/mobile-service",
          "ctaStyle": "link",
          "background": "card",
          "image": {
            "src": "/img/photo-placeholder.svg",
