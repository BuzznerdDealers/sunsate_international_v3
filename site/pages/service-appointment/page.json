                {
                  "id": "appt-sum-t",
                  "type": "text",
                  "props": {
                    "text": "Streamline your service experience with online service appointments for trucks and trailers. Easier and faster scheduling, assisted fleet management, and comprehensive service history tracking, backed by over 60 certified factory-trained technicians across Tampa, Sarasota, Davenport and Brooksville.\n\nTell us what the unit needs and when you'd like it in. A service advisor reviews your request, confirms a time and walks through the scope of work before repairs begin. If the truck or trailer can't make it to us, request mobile service and we'll come to you.",
                    "width": "prose"
                  }
                },
                {
                  "id": "appt-stats",
                  "type": "statBand",
                  "props": {
                    "stats": [
                      {
                        "value": "Same day",
                        "label": "Response on requests during service hours"
                      },
                      {
                        "value": "2 hrs",
                        "label": "ASED diagnostic evaluation and estimate on arrival"
                      },
                      {
                        "value": "24/7",
                        "label": "Coverage with after-hours support via Certified Fleet"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
