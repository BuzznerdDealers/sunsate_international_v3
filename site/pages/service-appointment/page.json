    {
      "id": "appt-fleet",
      "type": "sharedSection",
      "props": {
        "sectionId": "feature-grid",
        "values": {
          "eyebrow": "FLEETS AND TRAILERS",
          "heading": "Planned, not reactive.",
          "span": 6,
          "background": "card",
          "items": [
            {
              "title": "Fleet scheduling and service history",
              "body": "Online appointments give fleets assisted fleet management and comprehensive service history tracking, so preventative maintenance is planned rather than reactive. Fleet Charge, OnCommand Connection and International 360 keep pricing, diagnostics and repair status visible across your units.",
              "linkLabel": "See fleet service programs →",
              "linkUrl": "/service#services"
            },
            {
              "title": "Trailer service appointments",
              "body": "When your trailer requires maintenance, you can depend on Sun State for all your trailer parts and service needs. Kingpins, landing gear, aluminum and fiberglass repair, alignment, fabrication and welding, DOT inspections and complete liftgate care including new installations, remounts, warranty service and parts.",
              "linkLabel": "Trailer parts & service →",
              "linkUrl": "/parts#trailer-parts"
            }
          ]
        }
      }
