                        {
                          "q": "Where is the Sun State Aftermarket Business?",
                          "a": "Sun State International Trucks, LLC. – Aftermarket Business is at 7105 East 6th Ave., Tampa, FL 33619, a few minutes from the Adamo Drive dealership. Phone (813) 627-3282, fax (813) 621-8709."
                        },
                        {
                          "q": "What are the Aftermarket store hours?",
                          "a": "The store is open 7:00 AM to 4:00 PM Monday through Friday, and closed Saturday and Sunday."
                        },
                        {
                          "q": "What does the Aftermarket facility specialize in?",
                          "a": "Truck equipment repair, roll off cable repair and hydraulic truck equipment repair, plus all-makes body installations and swaps, liftgates, body equipment, frame modifications, DPF and DOC cleaning, and all-makes trailer parts and service."
                        },
                        {
                          "q": "Which parts lines are stocked here?",
                          "a": "Godwin dump body parts, Galbreath roll-off hoist and hooklift parts, Hyundai and all-makes trailer parts, Capacity yard tractor parts and warranty, E-Z Ride and Silent Drive lift axle parts, and A/C parts from Carrier, MCC, ACT, Transair and Busair."
                        },
                        {
                          "q": "Do you offer pickup and delivery?",
                          "a": "Yes. The Aftermarket location offers in-store shopping, in-store pickup and delivery."
                        },
                        {
                          "q": "Can you modify a frame without voiding the factory warranty?",
                          "a": "Yes. Frame work includes shortening and lengthening, double single rails, driveline work and Huck bolt replacement to maintain factory warranty on all makes."
                        }
