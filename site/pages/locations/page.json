                      "items": [
                        {
                          "q": "How many Sun State locations are there?",
                          "a": "Six: full dealerships in Tampa, Davenport and Sarasota, Truck & Trailer Parts in Brooksville, Sun State Aftermarket Parts in Tampa, and Sun State Trailers Trailer Sales in Tampa."
                        },
                        {
                          "q": "What are the service department hours?",
                          "a": "Tampa and Davenport service run 7 AM to 7 PM Monday through Friday and 7 AM to 12 PM Saturday. Sarasota service runs 7 AM to 5 PM Monday through Friday. After-hours service is available via Certified Fleet from 5 PM to 8 AM."
                        },
                        {
                          "q": "Which locations sell trailers?",
                          "a": "Sun State Trailers Trailer Sales is at 6020 E Adamo Dr in Tampa, open 8 AM to 5 PM Monday through Friday. Trailer parts and service are available in Tampa, Davenport and Sarasota, and trailer parts are also stocked in Brooksville."
                        },
                        {
                          "q": "Where do I go for aftermarket modifications?",
                          "a": "Sun State Aftermarket Parts at 7105 East 6th Ave, Tampa, FL 33619, open 7 AM to 4 PM Monday through Friday. Call (813) 627-3282."
                        },
                        {
                          "q": "Do you offer curbside pickup or delivery?",
                          "a": "The Tampa, Davenport and Sarasota dealerships offer in-store shopping and curbside pickup. The Brooksville, Aftermarket and Trailer Sales locations offer in-store shopping, in-store pickup and delivery."
                        },
                        {
                          "q": "Which areas do you serve?",
                          "a": "Our locations serve Tampa, Sarasota, Davenport and Brooksville along with St. Petersburg, Lakeland, Orlando, Bradenton and the rest of Central and Southwest Florida, plus mobile service at your yard or job site."
                        }
                      ]
