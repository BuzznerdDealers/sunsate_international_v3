    {
      "id": "parts-return",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "OUR PARTS RETURN POLICY",
          "body": "Transparency matters. Sun State International's Parts Return Policy is designed to be clear, fair, and straightforward, so you know exactly what to expect. If you got the wrong part or need to switch one out, our team is always available to walk you through the process and answer questions before or after your purchase, ensuring there are no surprises.",
          "ctaLabel": "Parts Return Policy →",
          "ctaUrl": "https://sunstateintl.com/wp-content/uploads/2024/08/Parts-Return-Policy-2022-Final.pdf",
          "ctaStyle": "link",
