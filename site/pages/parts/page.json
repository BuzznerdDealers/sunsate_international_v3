      "id": "parts-hero",
      "type": "hero",
      "props": {
        "headingLevel": 1,
        "eyebrow": "PARTS DEPARTMENT",
        "headline": "Find the parts you need, people you trust, and the support that keeps your business moving.",
        "image": {
