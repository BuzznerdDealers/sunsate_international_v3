    {
      "id": "parts-support",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "MORE THAN PARTS: SERVICE & MOBILE SUPPORT",
          "body": "Finding the right part is only one piece of the puzzle. If you need help installing or replacing a component, Sun State International's Service Department is ready to assist with experienced technicians who know your equipment.\n\nFor situations where getting to a shop isn't practical, our Mobile Service team can come to you. Mobile support helps minimize downtime, reduce towing costs, and get your truck or trailer safely off the roadside and back into operation as quickly as possible.",
          "ctaLabel": "Explore Our Service Department →",
          "ctaUrl": "/service",
          "ctaStyle": "link",
          "background": "card",
          "anchor": "mobile-support",
          "image": {
            "src": "/img/photo-placeholder.svg",
            "alt": "A Sun State mobile service truck — photograph to be supplied",
            "width": 1600,
            "height": 900
          },
          "width": "full",
          "cta2Label": "Get Mobile Help ASAP →",
          "cta2Url": "/mobile-service"
        }
      }
    },
    {
      "id": "parts-online",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "ONLINE PARTS ORDERS",
          "body": "Sun State International makes ordering parts simple. If you already know what you need, you can submit a request through our Parts Request page or work directly with one of our parts professionals.\n\nYou're also welcome to visit our parts stores and dealerships in Tampa, Sarasota, Brooksville, and Davenport, proudly serving St. Petersburg, Lakeland, Haines City, Clearwater, Venice, and surrounding areas.",
          "ctaLabel": "Part Request →",
          "ctaUrl": "/contact",
