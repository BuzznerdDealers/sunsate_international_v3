    {
      "id": "parts-credit",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "FLEXIBLE CREDIT OPTIONS",
          "body": "We understand that cash flow is a real concern for many fleets and owner-operators. Sun State International offers flexible credit options to help you get the parts you need without unnecessary strain on your budget. With an approved credit application, you can bundle purchases and manage expenses more efficiently. Our in-house team works with you to create solutions that support your business, not complicate it.",
          "ctaLabel": "Sun State Credit Application →",
          "ctaUrl": "https://www.sunstateintl.com/wp-content/uploads/2026/05/IBS-Credit-App-for-intranet.pdf",
          "ctaStyle": "link",
          "background": "paper",
          "anchor": "credit-options",
