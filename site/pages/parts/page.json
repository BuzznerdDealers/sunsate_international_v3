          "children": [
            {
              "id": "parts-faq-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "parts-faq-list",
                  "type": "widget",
                  "props": {
                    "widget": "faq",
                    "config": {
                      "items": [
                        {
                          "q": "Do you carry both truck and trailer parts?",
                          "a": "Yes. Sun State International supports both truck and trailer parts, including equipment from International, IC Bus, Globe, Hyundai Translead, and Capacity Yard Trucks."
                        },
                        {
                          "q": "Can you help me find a part if I don't have a part number?",
                          "a": "Absolutely. Our parts professionals can assist with lookups using vehicle details and system information to ensure accuracy."
                        },
                        {
                          "q": "Do you offer local delivery?",
                          "a": "Yes. We deliver locally to Hillsborough, Pinellas, Pasco, Polk, Brooksville, Hernando, DeSoto, Highlands, Hardee, Manatee and Sarasota counties to help reduce downtime and keep operations moving."
                        },
                        {
                          "q": "Where are the Sun State parts stores located?",
                          "a": "Parts stores are in Tampa, Sarasota, Brooksville and Davenport, plus the Sun State Aftermarket Parts store at 7105 East 6th Ave in Tampa."
                        },
                        {
                          "q": "Can I order Sun State parts online?",
                          "a": "Yes. Register at the Sun State online parts store to browse inventory and order truck and trailer parts, with local delivery available across West Central Florida."
                        }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
