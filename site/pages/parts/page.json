    {
      "id": "parts-intro",
      "type": "sharedSection",
      "props": {
        "sectionId": "media-band",
        "values": {
          "eyebrow": "SEMI TRUCK & TRAILER PARTS YOUR BUSINESS CAN DEPEND ON",
          "heading": "Downtime is lost revenue.",
          "body": "When your truck or trailer needs a part, downtime isn't just an inconvenience; it's lost revenue. The Parts Department at Sun State International is built around one goal: helping you get the right part, fast, with service you can count on. Whether you're replacing a critical component or planning ahead with routine maintenance parts, our team is here to make the process straightforward, efficient, and dependable.",
          "ctaLabel": "Find a Location",
          "ctaUrl": "/locations",
          "ctaStyle": "primary",
          "background": "card",
          "image": {
            "src": "/img/photo-placeholder.svg",
            "alt": "The Sun State parts warehouse — photograph to be supplied",
            "width": 1600,
            "height": 900
          },
          "width": "full"
        }
      }
    },
    {
      "id": "parts-offer",
      "type": "sharedSection",
      "props": {
        "sectionId": "feature-grid",
        "values": {
          "heading": "Everything your fleet needs to keep rolling.",
          "span": 4,
          "background": "card",
          "items": [
            {
              "title": "International OEM Parts",
              "body": "As part of the International Truck family, Sun State International has access to one of the most extensive parts networks in the industry. We maintain over $3 million in on-hand inventory and have access to more than one million unique parts, giving our customers the confidence that what they need is within reach. Choosing OEM means fewer surprises, better compatibility, and confidence that the part will perform the way it was designed to.",
              "linkLabel": "Talk to a Rep Now →",
              "linkUrl": "/contact"
            },
            {
              "title": "Aftermarket Parts",
              "body": "In addition to OEM solutions, Sun State International offers a wide range of aftermarket truck parts to support different budgets and operating needs. Aftermarket options can be a cost-effective solution for many applications while still delivering dependable performance. Our parts specialists help you compare options so you can make informed decisions.",
              "linkLabel": "Visit our Tampa location →",
              "linkUrl": "/locations/aftermarket-parts"
            },
            {
              "title": "Beyond Semi Truck Parts",
              "body": "We offer all OE truck & trailer parts for International, IC Bus, Globe, and Hyundai Translead equipment, giving fleets and owner-operators a single, reliable place to turn. Stop in, call ahead, or work with one of our parts professionals to experience service that's focused on getting you back on the road, not slowing you down."
            }
          ],
          "eyebrow": "PARTS WE OFFER",
          "body": "Our Parts Department supports both truck and trailer operations, offering a wide selection of heavy-duty and medium-duty commercial truck parts and accessories. From essential wear items to specialized components, our team works quickly to locate the exact part your equipment requires. If it's not on our shelf today, we'll source it through our trusted network and get it moving to you without delay.",
          "ctaLabel": "See what's Available Now →",
          "ctaUrl": "/inventory",
          "cta2Label": "Parts Specials →",
          "cta2Url": "/deal-of-the-week"
        }
      }
    },
