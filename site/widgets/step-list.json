{
  "id": "step-list",
  "label": "Numbered steps",
  "description": "Numbered steps, each a dark number square beside a short title and a sentence — the blog's how-a-service-visit-works sequence. One item per step.",
  "props": [
    {
      "key": "items",
      "type": "list",
      "label": "Steps",
      "fields": [
        {
          "key": "num",
          "type": "text",
          "label": "Number"
        },
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "text",
          "type": "textarea",
          "label": "Sentence"
        }
      ]
    }
  ],
  "html": "<ol class=\"ss-steps\">{{#each items}}<li class=\"ss-step\"><span class=\"ss-step__n\" aria-hidden=\"true\">{{num}}</span><div><h3 class=\"ss-step__t\">{{title}}</h3><p class=\"ss-step__p\">{{text}}</p></div></li>{{/each}}</ol>",
  "css": ".ss-steps{list-style:none;margin:0;padding:0}\n.ss-step{display:flex;gap:18px;margin-bottom:24px}\n.ss-step__n{flex-shrink:0;width:40px;height:40px;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font:800 16px/1 var(--font-heading)}\n.ss-step__t{font:800 19px/1.3 var(--font-heading);color:var(--ink);text-transform:none;margin:0 0 6px}\n.ss-step__p{font-size:17px;line-height:1.8;color:var(--body-text);margin:0}"
}
