{
  "id": "link-cards",
  "label": "Link cards",
  "description": "Bordered cards that are each one link — a small accent label over a destination, such as New / Pre-owned or Inventory / Parts / Service. The border darkens on hover. One item per card.",
  "props": [
    {
      "key": "across",
      "type": "select",
      "label": "Cards across",
      "default": "2",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ]
    },
    {
      "key": "items",
      "type": "list",
      "label": "Cards",
      "fields": [
        {
          "key": "label",
          "type": "text",
          "label": "Label"
        },
        {
          "key": "title",
          "type": "text",
          "label": "Destination"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Link"
        },
        {
          "key": "newTab",
          "type": "boolean",
          "label": "Open in a new tab"
        }
      ]
    }
  ],
  "html": "<div class=\"ss-lc ss-lc--{{across}}\">{{#each items}}<a class=\"ss-lc__card\" href=\"{{link url}}\"{{#if newTab}} target=\"_blank\" rel=\"noopener\"{{/if}}><span class=\"ss-lc__l\">{{label}}</span><span class=\"ss-lc__t\">{{title}}</span></a>{{/each}}</div>",
  "css": ".ss-lc{display:grid;gap:16px}\n.ss-lc--2{grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:20px}\n.ss-lc--3{grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:24px}\n.ss-lc__card{display:block;border:1px solid var(--line);padding:20px;color:var(--ink);text-decoration:none;transition:border-color .18s ease}\n.ss-lc__card:hover{border-color:var(--ink)}\n.ss-lc__l{display:block;font:700 11px/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}\n.ss-lc__t{display:block;font:800 19px/1.3 var(--font-heading);color:var(--ink)}\n.ss-lc--3 .ss-lc__t{font-size:18px}\n@media (max-width:1100px){.ss-lc--3{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (max-width:640px){.ss-lc--2,.ss-lc--3{grid-template-columns:minmax(0,1fr)}}"
}
