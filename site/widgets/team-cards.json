{
  "id": "team-cards",
  "label": "Team cards",
  "description": "One department's people as a four-up card grid: portrait, name and title. A person with no photo gets the initials tile the design falls back to. Each card is a filter item carrying its department, so the pills above the bands filter the whole page without a script.",
  "props": [
    {
      "key": "deptKey",
      "type": "text",
      "label": "Department key — must match the filter pill's value"
    },
    {
      "key": "people",
      "type": "list",
      "label": "People",
      "fields": [
        {
          "key": "name",
          "type": "text",
          "label": "Name"
        },
        {
          "key": "title",
          "type": "text",
          "label": "Job title"
        },
        {
          "key": "photo",
          "type": "image",
          "label": "Portrait"
        },
        {
          "key": "initials",
          "type": "text",
          "label": "Initials — drawn on a dark tile when there is no portrait"
        },
        {
          "key": "badge",
          "type": "text",
          "label": "Corner badge, e.g. Trailers"
        }
      ]
    }
  ],
  "html": "<ul class=\"ss-team\">{{#each people}}<li class=\"ss-team__i\" data-bz-part=\"item\" data-dept=\"{{deptKey}}\"><div class=\"ss-team__m\">{{#if photo}}{{img photo}}{{else}}<span class=\"ss-team__ini\" aria-hidden=\"true\">{{initials}}</span>{{/if}}{{#if badge}}<span class=\"ss-team__b\">{{badge}}</span>{{/if}}</div><p class=\"ss-team__n\">{{name}}</p>{{#if title}}<p class=\"ss-team__t\">{{title}}</p>{{/if}}</li>{{/each}}</ul>",
  "css": ".ss-team{display:grid;grid-template-columns:repeat(4,1fr);gap:34px 20px;margin:0;padding:0;list-style:none}\n.ss-team__i{margin:0}\n.ss-team__i[hidden]{display:none}\n.ss-team__m{position:relative;aspect-ratio:4/5;background:var(--ink);overflow:hidden}\n.ss-team__m img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;display:block}\n.ss-team__ini{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:700 30px/1 var(--font-heading);letter-spacing:.06em;color:#fff}\n.ss-team__b{position:absolute;left:0;bottom:14px;padding:5px 9px;background:var(--accent);color:#fff;font:700 9px/1 var(--font-body);letter-spacing:.14em;text-transform:uppercase}\n.ss-team__n{margin:14px 0 0;padding-top:13px;border-top:2px solid var(--ink);font:700 13px/1.3 var(--font-heading);letter-spacing:.02em;text-transform:uppercase;color:var(--ink)}\n.ss-team__t{margin:6px 0 0;font:400 12px/1.5 var(--font-body);color:var(--muted)}\n@media (max-width:1100px){.ss-team{grid-template-columns:repeat(3,1fr)}}\n@media (max-width:820px){.ss-team{grid-template-columns:repeat(2,1fr)}}\n@media (max-width:480px){.ss-team{grid-template-columns:1fr;gap:28px}}"
}
