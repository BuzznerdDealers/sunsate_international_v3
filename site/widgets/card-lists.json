{
  "id": "card-lists",
  "label": "Card lists",
  "description": "Bordered cards side by side, each a title, an optional sentence and a bulleted list — the blog's OEM-versus-aftermarket pair and its preventive-maintenance groups and the mileage interval cards. One card per item, each with its own list of points, so a card or a point is added in the list editor rather than by copying a box.",
  "props": [
    {
      "key": "variant",
      "type": "select",
      "label": "Card style",
      "default": "compare",
      "options": [
        {
          "value": "compare",
          "label": "Comparison — roomy, the title set well down"
        },
        {
          "value": "group",
          "label": "Group — compact, the title at the top"
        },
        {
          "value": "interval",
          "label": "Interval — four across, the title as a small accent label"
        }
      ]
    },
    {
      "key": "items",
      "type": "list",
      "label": "Cards",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "intro",
          "type": "textarea",
          "label": "Sentence under the title (optional)"
        },
        {
          "key": "points",
          "type": "list",
          "label": "Points",
          "fields": [
            {
              "key": "text",
              "type": "text",
              "label": "Point"
            }
          ]
        }
      ]
    }
  ],
  "html": "<div class=\"ss-cl ss-cl--{{variant}}\">{{#each items}}<div class=\"ss-cl__card\"><h3 class=\"ss-cl__t\">{{title}}</h3>{{#if intro}}<p class=\"ss-cl__p\">{{intro}}</p>{{/if}}<ul class=\"ss-cl__list\">{{#each points}}<li>{{text}}</li>{{/each}}</ul></div>{{/each}}</div>",
  "css": ".ss-cl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.ss-cl--compare{margin:8px 0 24px}\n.ss-cl--group{margin-bottom:8px}\n.ss-cl__card{border:1px solid var(--line)}\n.ss-cl--compare .ss-cl__card{padding:24px}\n.ss-cl--group .ss-cl__card{padding:22px 24px;margin-bottom:16px}\n.ss-cl__t{font:800 19px/1.3 var(--font-heading);color:var(--ink);text-transform:none;margin:30px 0 12px}\n.ss-cl--group .ss-cl__t{margin:0 0 12px}\n.ss-cl__p{font-size:15px;line-height:1.8;color:var(--body-text);margin:0 0 12px}\n.ss-cl__list{margin:0 0 20px;padding-left:20px}\n.ss-cl__list li{font-size:16px;line-height:1.75;color:var(--body-text);margin-bottom:6px}\n.ss-cl--interval{grid-template-columns:repeat(4,minmax(0,1fr));margin:8px 0 24px}\n.ss-cl--interval .ss-cl__card{padding:22px}\n.ss-cl--interval .ss-cl__t{font:700 11px/1 var(--font-body);letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin:0 0 10px}\n.ss-cl--interval .ss-cl__list{margin:0;padding-left:18px}\n@media (max-width:1100px){.ss-cl{grid-template-columns:minmax(0,1fr)}.ss-cl--interval{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (max-width:640px){.ss-cl--interval{grid-template-columns:minmax(0,1fr)}}"
}
