{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/store",
      "destination": "https://sunstateintl.buzznerdrv.com/store"
    },
    {
      "source": "/store/",
      "destination": "https://sunstateintl.buzznerdrv.com/store/"
    },
    {
      "source": "/store/:path*/",
      "destination": "https://sunstateintl.buzznerdrv.com/store/:path*/"
    },
    {
      "source": "/store/:path*",
      "destination": "https://sunstateintl.buzznerdrv.com/store/:path*"
    }
  ],
  "headers": [
    {
      "source": "/partials/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aftermarket-business-tampa-fl{/}?",
      "destination": "/locations/aftermarket-parts",
      "statusCode": 301
    },
    {
      "source": "/modifications-alterations-heavy-medium-duty-trucks-trailers-florida-aftermarket{/}?",
      "destination": "/aftermarket",
      "statusCode": 301
    },
    {
